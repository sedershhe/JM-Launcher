*.nupkg

# 运行时数据（配置/日志/缓存，不入库）
runtime_data/
logs/
# 程序目录下的数据根诊断标记（启动时自动生成，含本机路径，不入库）
runtime-data-root.txt

# 安全红线：凭据相关一律不入库
*.credentials
credentials.json
secrets.json
appsettings.local.json
option.yml

# Python
__pycache__/
*.pyc
.venv/

# pytest 本地测试环境（子代理变通方案产生，不入库）
_pytest_env/
_pytest_wheels/
_pytest_tmp/
_pt_bt/
_pt_tmp/
pip-*/
