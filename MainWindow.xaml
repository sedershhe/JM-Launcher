<!--
    JML 主窗口外壳（PCL2 同款浅色无边框，2026-10-17 重构）
    参数来源：docs/20261017_PCL2界面视觉规格_v1.0.md A/B 节，逐项对应 PCL2 源码：
      窗口（A1）：WindowStyle=None、AllowsTransparency=True、Background=null、900×550、
                  Min 810×470、透明外边 10+8、圆角 6（Border.Clip）、自绘 8 块渐变阴影、
                  自绘 8 个缩放手柄（MyResizer 同参数）。
      标题栏（A2）：高 48、纯色 ColorBrush4 #4890F5、文字 logo JML（17px 白）、
                  四个 27 高胶囊导航、右侧 28×28 最小化/关闭（右边距 12/44）。
      内页态（A2）：返回箭头 28×28 + 页面名 15px，主导航隐藏。
    三层骨架保持：顶部标题栏 + 内容区；左侧二级目录仍由 PluginHubPage 自己承载。
    动画（2026-10-17 追加，参数来源 docs/20261017_PCL2动效规格_v1.0.md 第 1 节）：
      窗口入场 = PanBack 的 TranslateY 60→0/600ms/Back弱 + Rotate -4→0/500ms/Back弱
                 + Window.Opacity 0→1/250ms，全部延迟 100ms；起始值写在 XAML，
                 动画在 MainWindow.xaml.cs 的 Loaded 里启动，结束后把 RenderTransform 归零。
      禁止动画 Window.Top/Left、禁止整窗 Effect（规格 1.3 / 13.2）。
-->
<Window x:Class="JML.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="JML"
        Width="900" Height="550"
        MinWidth="810" MinHeight="470"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="{x:Null}"
        Opacity="0"
        ResizeMode="CanResize"
        FontFamily="Microsoft YaHei UI"
        SnapsToDevicePixels="True"
        UseLayoutRounding="True"
        StateChanged="Window_StateChanged"
        MouseMove="Window_MouseMove"
        MouseLeftButtonUp="Window_MouseLeftButtonUp">

    <!-- 外层 Margin=10：透明阴影区（PCL2 PanBack Margin=10）
         入场动画作用在这层（PCL2 FormMain.xaml:17-18 的 Rotate -4 / TranslateY 60），
         不碰 Window.Top/Left，避免每帧移动原生窗口。动画结束时由代码把 RenderTransform 置空。 -->
    <Grid x:Name="PanBack" Margin="10" SnapsToDevicePixels="True" UseLayoutRounding="True"
          RenderTransformOrigin="0.5,0.5">
        <Grid.RenderTransform>
            <TransformGroup>
                <RotateTransform x:Name="WindowEntryRotate" Angle="-4" />
                <TranslateTransform x:Name="WindowEntryTranslate" X="0" Y="60" />
            </TransformGroup>
        </Grid.RenderTransform>

        <!-- ===== 自绘阴影 + 缩放命中区（PCL2 FormMain.xaml:21-88 原参数） =====
             上/下 8 高、左/右 8 宽、四角 13×13；边为线性渐变，角为径向渐变；
             不使用 DropShadowEffect（透明窗下会糊、掉帧）。 -->
        <Rectangle x:Name="ResizerT" Stroke="{x:Null}" StrokeThickness="0.0001"
                   Height="8" VerticalAlignment="Top" Margin="13,0" Cursor="SizeNS"
                   Tag="Top" MouseLeftButtonDown="ResizeHandle_MouseLeftButtonDown">
            <Rectangle.Fill>
                <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">
                    <GradientStop Color="#21000000" Offset="1" />
                    <GradientStop Color="#11000000" Offset="0.7" />
                    <GradientStop Color="#00000000" Offset="0" />
                </LinearGradientBrush>
            </Rectangle.Fill>
        </Rectangle>
        <Rectangle x:Name="ResizerB" Stroke="{x:Null}" StrokeThickness="0.0001"
                   Height="8" VerticalAlignment="Bottom" Margin="13,0" Cursor="SizeNS"
                   Tag="Bottom" MouseLeftButtonDown="ResizeHandle_MouseLeftButtonDown">
            <Rectangle.Fill>
                <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">
                    <GradientStop Color="#21000000" Offset="0" />
                    <GradientStop Color="#11000000" Offset="0.3" />
                    <GradientStop Color="#00000000" Offset="1" />
                </LinearGradientBrush>
            </Rectangle.Fill>
        </Rectangle>
        <Rectangle x:Name="ResizerR" Stroke="{x:Null}" StrokeThickness="0.0001"
                   Width="8" HorizontalAlignment="Right" Margin="0,13" Cursor="SizeWE"
                   Tag="Right" MouseLeftButtonDown="ResizeHandle_MouseLeftButtonDown">
            <Rectangle.Fill>
                <LinearGradientBrush EndPoint="1,0.5" StartPoint="0,0.5">
                    <GradientStop Color="#21000000" Offset="0" />
                    <GradientStop Color="#11000000" Offset="0.3" />
                    <GradientStop Color="#00000000" Offset="1" />
                </LinearGradientBrush>
            </Rectangle.Fill>
        </Rectangle>
        <Rectangle x:Name="ResizerL" Stroke="{x:Null}" StrokeThickness="0.0001"
                   Width="8" HorizontalAlignment="Left" Margin="0,13" Cursor="SizeWE"
                   Tag="Left" MouseLeftButtonDown="ResizeHandle_MouseLeftButtonDown">
            <Rectangle.Fill>
                <LinearGradientBrush EndPoint="1,0.5" StartPoint="0,0.5">
                    <GradientStop Color="#21000000" Offset="1" />
                    <GradientStop Color="#11000000" Offset="0.7" />
                    <GradientStop Color="#00000000" Offset="0" />
                </LinearGradientBrush>
            </Rectangle.Fill>
        </Rectangle>
        <Rectangle x:Name="ResizerLT" Stroke="{x:Null}" StrokeThickness="0.0001"
                   Width="13" Height="13" HorizontalAlignment="Left" VerticalAlignment="Top"
                   Cursor="SizeNWSE" Tag="TopLeft" MouseLeftButtonDown="ResizeHandle_MouseLeftButtonDown">
            <Rectangle.Fill>
                <RadialGradientBrush Center="1,1" GradientOrigin="1,1" RadiusX="1" RadiusY="1">
                    <GradientStop Color="#21000000" Offset="0.2" />
                    <GradientStop Color="#00000000" Offset="1" />
                </RadialGradientBrush>
            </Rectangle.Fill>
        </Rectangle>
        <Rectangle x:Name="ResizerLB" Stroke="{x:Null}" StrokeThickness="0.0001"
                   Width="13" Height="13" HorizontalAlignment="Left" VerticalAlignment="Bottom"
                   Cursor="SizeNESW" Tag="BottomLeft" MouseLeftButtonDown="ResizeHandle_MouseLeftButtonDown">
            <Rectangle.Fill>
                <RadialGradientBrush Center="1,0" GradientOrigin="1,0" RadiusX="1" RadiusY="1">
                    <GradientStop Color="#21000000" Offset="0.2" />
                    <GradientStop Color="#00000000" Offset="1" />
                </RadialGradientBrush>
            </Rectangle.Fill>
        </Rectangle>
        <Rectangle x:Name="ResizerRB" Stroke="{x:Null}" StrokeThickness="0.0001"
                   Width="13" Height="13" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                   Cursor="SizeNWSE" Tag="BottomRight" MouseLeftButtonDown="ResizeHandle_MouseLeftButtonDown">
            <Rectangle.Fill>
                <RadialGradientBrush Center="0,0" GradientOrigin="0,0" RadiusX="1" RadiusY="1">
                    <GradientStop Color="#21000000" Offset="0.2" />
                    <GradientStop Color="#00000000" Offset="1" />
                </RadialGradientBrush>
            </Rectangle.Fill>
        </Rectangle>
        <Rectangle x:Name="ResizerRT" Stroke="{x:Null}" StrokeThickness="0.0001"
                   Width="13" Height="13" HorizontalAlignment="Right" VerticalAlignment="Top"
                   Cursor="SizeNESW" Tag="TopRight" MouseLeftButtonDown="ResizeHandle_MouseLeftButtonDown">
            <Rectangle.Fill>
                <RadialGradientBrush Center="0,1" GradientOrigin="0,1" RadiusX="1" RadiusY="1">
                    <GradientStop Color="#21000000" Offset="0.2" />
                    <GradientStop Color="#00000000" Offset="1" />
                </RadialGradientBrush>
            </Rectangle.Fill>
        </Rectangle>

        <!-- 内层窗体内容：Margin=8、圆角 6（Clip 由 SizeChanged 同步 Rect） -->
        <Border x:Name="BorderForm" Margin="8"
                Background="{StaticResource JmlPageBackground}"
                CornerRadius="6"
                SnapsToDevicePixels="False"
                UseLayoutRounding="False">
            <Border.Clip>
                <RectangleGeometry x:Name="RectForm" RadiusX="6" RadiusY="6" />
            </Border.Clip>

            <Grid x:Name="PanForm" SnapsToDevicePixels="False" UseLayoutRounding="False">
                <Grid.RowDefinitions>
                    <RowDefinition Height="48" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- ===== 自定义标题栏（48 高，纯色 ColorObject4） ===== -->
                <Grid x:Name="PanTitle"
                      Grid.Row="0"
                      Height="48"
                      Background="{DynamicResource ColorBrush4}"
                      MouseLeftButtonDown="PanTitle_MouseLeftButtonDown">

                    <!-- 主模式：文字 logo + 居中一级导航（PCL2 三段式 1*/Auto/1*）
                         内页切换动效作用在本层：Opacity 1→0/150 + TranslateX 0→12/150；
                         返回时 0→1/150（延迟 200）+ TranslateX 12→0/350（延迟 200，Back 弱）。
                         Margin 尺寸不变，位移只走 RenderTransform（规格 13.2-3）。 -->
                    <Grid x:Name="MainHeader" RenderTransformOrigin="0.5,0.5">
                        <Grid.RenderTransform>
                            <TranslateTransform x:Name="MainHeaderShift" X="0" />
                        </Grid.RenderTransform>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="1*" />
                        </Grid.ColumnDefinitions>

                        <!-- 品牌：计划书 v1.4 的 UiLogoType=2 文本模式（FontSize 17、白、左 18） -->
                        <TextBlock Grid.Column="0"
                                   Text="JML"
                                   Margin="18,0,0,0"
                                   VerticalAlignment="Center"
                                   HorizontalAlignment="Left"
                                   FontSize="17"
                                   FontWeight="Bold"
                                   Foreground="White"
                                   IsHitTestVisible="False" />

                        <StackPanel Grid.Column="1"
                                    x:Name="PanTitleSelect"
                                    Orientation="Horizontal"
                                    Height="27"
                                    VerticalAlignment="Center"
                                    HorizontalAlignment="Left"
                                    Margin="13,0">

                            <RadioButton x:Name="NavDownload"
                                         Style="{StaticResource NavRadioButton}"
                                         GroupName="MainNav"
                                         AutomationProperties.Name="下载"
                                         Checked="Nav_Checked">
                                <StackPanel Orientation="Horizontal">
                                    <Path Width="16" Height="16" Stretch="Uniform"
                                          RenderTransformOrigin="0.5,0.5"
                                          Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"
                                          Data="M955 610h-59c-15 0-29 13-29 29v196c0 15-13 29-29 29h-649c-15 0-29-13-29-29v-196c0-15-13-29-29-29h-59c-15 0-29 13-29 29V905c0 43 35 78 78 78h787c43 0 78-35 78-78V640c0-15-13-29-29-29zM492 740c11 11 29 11 41 0l265-265c11-11 11-29 0-41l-41-41c-11-11-29-11-41 0l-110 110c-11 11-33 3-33-13V68C571 53 555 39 541 39h-59c-15 0-29 13-29 29v417c0 17-21 25-33 13l-110-110c-11-11-29-11-41 0L226 433c-11 11-11 29 0 41L492 740z">
                                        <Path.RenderTransform>
                                            <ScaleTransform ScaleX="0.9" ScaleY="0.9" />
                                        </Path.RenderTransform>
                                    </Path>
                                    <TextBlock Text="下载" VerticalAlignment="Center" Margin="8,0,0,0"
                                               Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" />
                                </StackPanel>
                            </RadioButton>

                            <RadioButton x:Name="NavSearch"
                                         Style="{StaticResource NavRadioButton}"
                                         GroupName="MainNav"
                                         AutomationProperties.Name="搜索"
                                         Checked="Nav_Checked">
                                <StackPanel Orientation="Horizontal">
                                    <!-- 放大镜为 JML 自绘图形（PCL2 一级导航无搜索项） -->
                                    <Path Width="16" Height="16" Stretch="Uniform"
                                          RenderTransformOrigin="0.5,0.5"
                                          Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"
                                          Data="M6.5,0 a6.5,6.5 0 1 0 0,13 a6.5,6.5 0 1 0 0,-13 z M6.5,2.2 a4.3,4.3 0 1 1 0,8.6 a4.3,4.3 0 1 1 0,-8.6 z M10.9,12.1 L12.4,10.6 L16.9,15.1 a1.06,1.06 0 0 1 -1.5,1.5 z">
                                        <Path.RenderTransform>
                                            <ScaleTransform ScaleX="1" ScaleY="1" />
                                        </Path.RenderTransform>
                                    </Path>
                                    <TextBlock Text="搜索" VerticalAlignment="Center" Margin="8,0,0,0"
                                               Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" />
                                </StackPanel>
                            </RadioButton>

                            <RadioButton x:Name="NavPlugin"
                                         Style="{StaticResource NavRadioButton}"
                                         GroupName="MainNav"
                                         AutomationProperties.Name="插件"
                                         Checked="Nav_Checked">
                                <StackPanel Orientation="Horizontal">
                                    <!-- 图标沿用 PCL2 导航 Path（FormMain.xaml:130 “更多”四格），用户已确认可复用 -->
                                    <Path Width="16" Height="16" Stretch="Uniform"
                                          RenderTransformOrigin="0.5,0.5"
                                          Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"
                                          Data="M364 0h-273C40 0 0 40 0 91v273C0 414 40 455 91 455h273C414 455 455 414 455 364V91C455 40 414 0 364 0zM341 341H113V113h227v227zM933 0h-273C609 0 568 40 568 91v273c0 50 40 91 91 91h273C983 455 1024 414 1024 364V91c0-50-40-91-90-91zM910 341h-227V113h227v227zM364 568h-273C40 568 0 609 0 659v273c0 50 40 91 91 91h273C414 1024 455 983 455 932v-273C455 609 414 568 364 568zM341 910H113v-227h227v227zM933 568h-273c-50 0-91 40-91 91v273c0 50 40 91 91 91h273c50 0 90-40 90-91v-273c0-50-40-90-90-90zM910 910h-227v-227h227v227z">
                                        <Path.RenderTransform>
                                            <ScaleTransform ScaleX="1.05" ScaleY="1.05" />
                                        </Path.RenderTransform>
                                    </Path>
                                    <TextBlock Text="插件" VerticalAlignment="Center" Margin="8,0,0,0"
                                               Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" />
                                </StackPanel>
                            </RadioButton>

                            <RadioButton x:Name="NavSettings"
                                         Style="{StaticResource NavRadioButton}"
                                         GroupName="MainNav"
                                         AutomationProperties.Name="设置"
                                         Checked="Nav_Checked">
                                <StackPanel Orientation="Horizontal">
                                    <!-- 图标沿用 PCL2 导航 Path（FormMain.xaml:128 齿轮六边形） -->
                                    <Path Width="16" Height="16" Stretch="Uniform"
                                          RenderTransformOrigin="0.5,0.5"
                                          Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"
                                          Data="M940.4 463.7L773.3 174.2c-17.3-30-49.2-48.4-83.8-48.4H340.2c-34.6 0-66.5 18.5-83.8 48.4L89.2 463.7c-17.3 30-17.3 66.9 0 96.8L256.4 850c17.3 30 49.2 48.4 83.8 48.4h349.2c34.6 0 66.5-18.5 83.8-48.4l167.2-289.5c17.3-29.9 17.3-66.8 0-96.8z m-94.6 96.8L725.9 768.1c-17.3 30-49.2 48.4-83.8 48.4H387.5c-34.6 0-66.5-18.5-83.8-48.4L183.9 560.5c-17.3-30-17.3-66.9 0-96.8l119.8-207.5c17.3-30 49.2-48.4 83.8-48.4h254.6c34.6 0 66.5 18.5 83.8 48.4l119.8 207.5c17.3 30 17.3 66.9 0.1 96.8z M522.3 321.2c-2.5-0.1-5-0.2-7.5-0.2-119.9 0-214 110.3-186.3 235 15.8 70.9 71.5 126.6 142.4 142.4 17.5 3.9 34.7 5.4 51.4 4.7 102.1-3.9 183.6-87.9 183.6-191 0.1-103-81.5-187-183.6-190.9z m68.6 269.1c-18.5 18-43 28.9-68.6 30.7l-6 0.3c-30.2 0.4-58.6-11.4-79.7-33-19.5-20.1-30.7-47-30.9-75-0.3-29.6 11.1-57.4 32-78.3 20.6-20.6 48-32 77.2-32 2.5 0 5 0.1 7.5 0.3 26.7 1.8 51.5 13.2 70.5 32.5 19.6 20 30.8 46.9 31.2 74.9 0.2 30.2-11.5 58.6-33.2 79.6z">
                                        <Path.RenderTransform>
                                            <ScaleTransform ScaleX="1.1" ScaleY="1.1" />
                                        </Path.RenderTransform>
                                    </Path>
                                    <TextBlock Text="设置" VerticalAlignment="Center" Margin="8,0,0,0"
                                               Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" />
                                </StackPanel>
                            </RadioButton>

                        </StackPanel>
                    </Grid>

                    <!-- 内页模式：返回箭头 28×28 + 页面名 15px（PCL2 FormMain.xaml:133-137）
                         动画：Opacity 0→1/150（延迟 200）+ TranslateX -16→0/350（延迟 200，Back 中）；
                         返回镜像：1→0/150 + 0→-18/150（EaseInFluent3）。 -->
                    <Grid x:Name="InnerHeader" Visibility="Collapsed" Opacity="0"
                          RenderTransformOrigin="0.5,0.5">
                        <Grid.RenderTransform>
                            <TranslateTransform x:Name="InnerHeaderShift" X="-16" />
                        </Grid.RenderTransform>
                        <Button x:Name="BtnBack"
                                Style="{StaticResource TitleIconButton}"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Center"
                                Margin="12,0,0,0"
                                AutomationProperties.Name="返回"
                                Click="BtnBack_Click">
                            <Path Width="18" Height="18" Stretch="Uniform"
                                  RenderTransformOrigin="0.5,0.5"
                                  Fill="{DynamicResource ColorBrush8}"
                                  Data="M1097 584 250 584 562 896C591 925 591 972 562 1001 533 1030 487 1030 458 1001L21 565C6 550-0 531 0 511L0 511 0 511C-0 492 6 472 21 457L458 21C487-7 533-7 562 21 591 50 591 97 562 126L250 438 1097 438C1137 438 1170 471 1170 511 1170 551 1137 584 1097 584L1097 584Z">
                                <Path.RenderTransform>
                                    <ScaleTransform ScaleX="0.87" ScaleY="0.87" />
                                </Path.RenderTransform>
                            </Path>
                        </Button>
                        <TextBlock x:Name="TextInnerTitle"
                                   VerticalAlignment="Center"
                                   HorizontalAlignment="Left"
                                   Margin="47,1,60,0"
                                   FontSize="15"
                                   Foreground="{DynamicResource ColorBrush8}"
                                   IsHitTestVisible="False" />
                    </Grid>

                    <!-- 右侧：最小化（右边距 44）+ 关闭（右边距 12），均 28×28 -->
                    <Button x:Name="BtnTitleMin"
                            Style="{StaticResource TitleIconButton}"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            Margin="0,0,44,0"
                            AutomationProperties.Name="最小化"
                            Click="BtnTitleMin_Click">
                        <Path Width="18" Height="18" Stretch="Uniform"
                              RenderTransformOrigin="0.5,0.5"
                              Fill="{DynamicResource ColorBrush8}"
                              Data="F1 M0,0 h15 v2 h-15 v-2 Z">
                            <Path.RenderTransform>
                                <ScaleTransform ScaleX="0.72" ScaleY="0.72" />
                            </Path.RenderTransform>
                        </Path>
                    </Button>
                    <Button x:Name="BtnTitleClose"
                            Style="{StaticResource TitleIconButton}"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            Margin="0,0,12,0"
                            AutomationProperties.Name="关闭"
                            Click="BtnTitleClose_Click">
                        <Path Width="18" Height="18" Stretch="Uniform"
                              RenderTransformOrigin="0.5,0.5"
                              Fill="{DynamicResource ColorBrush8}"
                              Data="F1 M2,0 L0,2 8,10 0,18 2,20 10,12 18,20 20,18 12,10 20,2 18,0 10,8 2,0Z">
                            <Path.RenderTransform>
                                <ScaleTransform ScaleX="0.72" ScaleY="0.72" />
                            </Path.RenderTransform>
                        </Path>
                    </Button>
                </Grid>

                <!-- ===== 内容区（各页面内容由 MainWindow 切换） ===== -->
                <ContentControl x:Name="MainContent" Grid.Row="1" />
            </Grid>
        </Border>
    </Grid>
</Window>
