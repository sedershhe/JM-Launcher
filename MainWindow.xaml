<!--
    JM Launcher 主窗口（阶段 1）
    PCL2 风格三层骨架：
      1) 顶部标题栏（高 48，渐变背景）：主模式为 Logo + 四个一级导航；内页模式为「← 返回 + 页面名」
      2) 下方为内容区（ContentControl 切换各页面；左侧栏内嵌于 PluginHubPage）
    本文件只负责骨架，页面细节见 Pages/ 目录。
-->
<Window x:Class="JML.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="JM Launcher" Height="720" Width="1080"
        MinWidth="800" MinHeight="600"
        WindowStartupLocation="CenterScreen">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="48" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- ===== 顶部标题栏（渐变背景） ===== -->
        <Border Grid.Row="0">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                    <GradientStop Color="{DynamicResource ColorObject8}" Offset="0" />
                    <GradientStop Color="{DynamicResource ColorObject6}" Offset="1" />
                </LinearGradientBrush>
            </Border.Background>

            <Grid>
            <!-- 主模式：Logo + 一级导航 -->
            <Grid x:Name="MainHeader">
                <TextBlock Text="JML"
                           VerticalAlignment="Center" Margin="16,0,0,0"
                           FontSize="17" FontWeight="Bold"
                           Foreground="{DynamicResource ColorBrush2}" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <RadioButton x:Name="NavDownload" Content="下载"
                                 Style="{StaticResource NavRadioButton}"
                                 GroupName="MainNav" Checked="Nav_Checked" />
                    <RadioButton x:Name="NavSearch" Content="搜索"
                                 Style="{StaticResource NavRadioButton}"
                                 GroupName="MainNav" Checked="Nav_Checked" />
                    <RadioButton x:Name="NavPlugin" Content="插件"
                                 Style="{StaticResource NavRadioButton}"
                                 GroupName="MainNav" Checked="Nav_Checked" />
                    <RadioButton x:Name="NavSettings" Content="设置"
                                 Style="{StaticResource NavRadioButton}"
                                 GroupName="MainNav" Checked="Nav_Checked" />
                </StackPanel>
            </Grid>

            <!-- 内页模式：返回 + 页面名 -->
            <Grid x:Name="InnerHeader" Visibility="Collapsed">
                <StackPanel Orientation="Horizontal" Margin="8,0,0,0">
                    <Button x:Name="BtnBack" Content="← 返回" Click="BtnBack_Click" />
                    <TextBlock x:Name="TextInnerTitle"
                               VerticalAlignment="Center" Margin="14,0,0,0"
                               FontSize="15" FontWeight="SemiBold"
                               Foreground="{DynamicResource ColorBrush1}" />
                </StackPanel>
            </Grid>
            </Grid>
        </Border>

        <!-- ===== 内容区 ===== -->
        <ContentControl x:Name="MainContent" Grid.Row="1" />
    </Grid>
</Window>
