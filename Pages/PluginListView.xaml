<!--
    插件管理视图（阶段 1）
    DataGrid 显示插件清单（名称/版本/状态/说明），下方为操作按钮与状态栏。
    所有 Python 调用经 PluginBridge + Task.Run，不阻塞 UI 线程。
-->
<UserControl x:Class="JML.Pages.PluginListView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <DataGrid x:Name="GridPlugins"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  CanUserAddRows="False"
                  CanUserDeleteRows="False"
                  SelectionMode="Single"
                  HeadersVisibility="Column"
                  GridLinesVisibility="Horizontal">
            <DataGrid.Columns>
                <DataGridTextColumn Header="名称" Binding="{Binding Name}" Width="2*" />
                <DataGridTextColumn Header="版本" Binding="{Binding Version}" Width="80" />
                <DataGridTextColumn Header="状态" Binding="{Binding Status}" Width="110" />
                <DataGridTextColumn Header="说明" Binding="{Binding Description}" Width="3*" />
            </DataGrid.Columns>
        </DataGrid>

        <!-- 操作按钮（启用/停用先占位禁用：阶段 3 依赖配置文件服务） -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,10,0,0">
            <Button x:Name="BtnEnable" Content="启用" IsEnabled="False"
                    ToolTip="阶段 3 实现（依赖配置文件服务）" />
            <Button x:Name="BtnDisable" Content="停用" Margin="8,0,0,0" IsEnabled="False"
                    ToolTip="阶段 3 实现（依赖配置文件服务）" />
            <Button x:Name="BtnRescan" Content="重新扫描" Margin="8,0,0,0"
                    Click="BtnRescan_Click" />
        </StackPanel>

        <TextBlock x:Name="TextStatus" Grid.Row="2"
                   Margin="0,8,0,0"
                   Foreground="{DynamicResource ColorBrushGray3}"
                   TextWrapping="Wrap" />
    </Grid>
</UserControl>
