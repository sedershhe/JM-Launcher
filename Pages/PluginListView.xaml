<!--
    插件管理视图（阶段 1，2026-10-17 页面层 PCL2 化；2026-10-19 列表改为 PCL2 资源行）
    ============================================================
    列表外观与 PCL2 Mod / 整合包搜索列表一致（Controls\JmlControls.xaml 的
    JmlResourceRowTemplate）：行高 64、无表头，左侧 JML 六边形占位图标，
    标题为插件名、副标题为版本、标签为状态、描述为插件说明、底部显示插件 id。
    下方为操作按钮与状态栏；双击行打开详情窗。
    所有 Python 调用经 PluginBridge + Task.Run，不阻塞 UI 线程；x:Name 保持不变。
-->
<UserControl x:Class="JML.Pages.PluginListView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ctl="clr-namespace:JML.Controls">
    <Grid Margin="25,15,25,25">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ctl:JmlCard Grid.Row="0"
                     Header="插件列表"
                     Padding="12,40,12,12"
                     VerticalAlignment="Stretch">
            <DataGrid x:Name="GridPlugins"
                      Style="{StaticResource JmlDataGrid}"
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      CanUserAddRows="False"
                      CanUserDeleteRows="False"
                      CanUserSortColumns="False"
                      CanUserReorderColumns="False"
                      CanUserResizeColumns="False"
                      SelectionMode="Single"
                      HeadersVisibility="None"
                      GridLinesVisibility="None"
                      RowHeight="64"
                      Background="Transparent"
                      ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                      SelectionChanged="GridPlugins_SelectionChanged"
                      MouseDoubleClick="GridPlugins_MouseDoubleClick">
                <DataGrid.CellStyle>
                    <Style TargetType="DataGridCell"
                           BasedOn="{StaticResource PlainDataGridCell}">
                        <Setter Property="Padding" Value="0" />
                        <Setter Property="BorderThickness" Value="0" />
                        <Setter Property="Background" Value="Transparent" />
                    </Style>
                </DataGrid.CellStyle>
                <DataGrid.Columns>
                    <DataGridTemplateColumn Width="*"
                                            CellTemplate="{StaticResource JmlResourceRowTemplate}" />
                </DataGrid.Columns>
            </DataGrid>
        </ctl:JmlCard>

        <!-- 操作按钮：启用/停用经 Python 插件管理入口（阶段 4-5），选中行后才可用。 -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,12,0,0">
            <Button x:Name="BtnEnable" Content="启用" IsEnabled="False"
                    Style="{StaticResource SecondaryButton}"
                    Click="BtnEnable_Click"
                    ToolTip="启用选中插件（重启后加载）" />
            <Button x:Name="BtnDisable" Content="停用" Margin="8,0,0,0" IsEnabled="False"
                    Style="{StaticResource SecondaryButton}"
                    Click="BtnDisable_Click"
                    ToolTip="停用选中插件（重启后生效；依赖它的插件会被拒绝加载）" />
            <Button x:Name="BtnRescan" Content="重新扫描" Margin="8,0,0,0"
                    Style="{StaticResource SecondaryButton}"
                    Click="BtnRescan_Click" />
        </StackPanel>

        <TextBlock x:Name="TextStatus" Grid.Row="2"
                   Margin="0,8,0,0"
                   Foreground="{DynamicResource ColorBrushGray3}"
                   TextWrapping="Wrap" />
    </Grid>
</UserControl>
