<!--
    插件管理视图（阶段 1，2026-10-17 页面层 PCL2 化）
    DataGrid 显示插件清单（名称/版本/状态/说明），下方为操作按钮与状态栏。
    参数来源：docs/20261017_PCL2界面视觉规格_v1.0.md B/C/E 节：
      内容外边距 25；DataGrid 无粗边框、行高 36（PCL2 列表项行高）、浅色表头；
      操作按钮统一用 35 高 PCL2 次按钮（MyButton）。
    所有 Python 调用经 PluginBridge + Task.Run，不阻塞 UI 线程；x:Name 保持不变。
-->
<UserControl x:Class="JML.Pages.PluginListView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="25,15,25,25">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <DataGrid x:Name="GridPlugins"
                  Style="{StaticResource JmlDataGrid}"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  CanUserAddRows="False"
                  CanUserDeleteRows="False"
                  SelectionChanged="GridPlugins_SelectionChanged"
                  MouseDoubleClick="GridPlugins_MouseDoubleClick">
            <DataGrid.Columns>
                <DataGridTextColumn Header="名称" Binding="{Binding Name}" Width="2*" />
                <DataGridTextColumn Header="版本" Binding="{Binding Version}" Width="80" />
                <DataGridTextColumn Header="状态" Binding="{Binding Status}" Width="220" />
                <!-- 说明：单元格里截断 + 省略号，悬停 ToolTip 显示完整多行说明；
                     双击行打开详情窗看全文。 -->
                <DataGridTemplateColumn Header="说明" Width="3*">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Description}"
                                       TextTrimming="CharacterEllipsis"
                                       HorizontalAlignment="Stretch"
                                       VerticalAlignment="Center"
                                       Foreground="{DynamicResource ColorBrush1}">
                                <TextBlock.ToolTip>
                                    <ToolTip MaxWidth="480">
                                        <TextBlock Text="{Binding Description}"
                                                   TextWrapping="Wrap"
                                                   FontSize="12" />
                                    </ToolTip>
                                </TextBlock.ToolTip>
                            </TextBlock>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>

        <!-- 操作按钮：启用/停用经 Python 插件管理入口（阶段 4-5），选中行后才可用。 -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,12,0,0">
            <Button x:Name="BtnEnable" Content="启用" IsEnabled="False"
                    Style="{StaticResource SecondaryButton}"
                    Click="BtnEnable_Click"
                    ToolTip="启用选中插件（重启后加载）" />
            <Button x:Name="BtnDisable" Content="停用" Margin="8,0,0,0" IsEnabled="False"
                    Style="{StaticResource SecondaryButton}"
                    Click="BtnDisable_Click"
                    ToolTip="停用选中插件（重启后生效；依赖它的插件会被拒绝加载）" />
            <Button x:Name="BtnRescan" Content="重新扫描" Margin="8,0,0,0"
                    Style="{StaticResource SecondaryButton}"
                    Click="BtnRescan_Click" />
        </StackPanel>

        <TextBlock x:Name="TextStatus" Grid.Row="2"
                   Margin="0,8,0,0"
                   Foreground="{DynamicResource ColorBrushGray3}"
                   TextWrapping="Wrap" />
    </Grid>
</UserControl>
