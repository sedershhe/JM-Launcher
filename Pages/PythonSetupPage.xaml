<!--
    Python 环境检测引导页（阶段 1）
    启动时的第一道关卡：检测通过才允许进入主界面。
    检测文本来自 PythonEnvironmentReport.ToUserText()。
-->
<UserControl x:Class="JML.Pages.PythonSetupPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="24">
        <ContentControl Style="{StaticResource PlainCard}"
                        VerticalAlignment="Center"
                        MaxWidth="640">
            <StackPanel>
                <TextBlock Text="Python 环境检测" FontSize="18" FontWeight="SemiBold" />
                <TextBlock Text="JM Launcher 依赖本机 Python 运行插件与业务逻辑。首次启动前请先完成环境检测。"
                           Margin="0,6,0,12"
                           TextWrapping="Wrap"
                           Foreground="{DynamicResource ColorBrushGray3}" />

                <Border BorderBrush="{DynamicResource ColorBrushGray6}"
                        BorderThickness="1" CornerRadius="3"
                        Background="{DynamicResource ColorBrushWhite}"
                        Padding="10">
                    <TextBox x:Name="TextReport"
                             IsReadOnly="True"
                             AcceptsReturn="True"
                             TextWrapping="Wrap"
                             VerticalScrollBarVisibility="Auto"
                             MinHeight="160" MaxHeight="300"
                             BorderThickness="0"
                             Background="Transparent"
                             FontFamily="Consolas" FontSize="12" />
                </Border>

                <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                    <Button x:Name="BtnRetry" Content="重新检测" Click="BtnRetry_Click" />
                    <Button x:Name="BtnContinue" Content="进入主界面" Margin="10,0,0,0"
                            IsEnabled="False" Click="BtnContinue_Click" />
                </StackPanel>
            </StackPanel>
        </ContentControl>
    </Grid>
</UserControl>
