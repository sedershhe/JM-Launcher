<!--
    详情窗（阶段 2-C，2026-10-17 页面层 PCL2 化）
    展示：封面、标题、作者、页数、标签、简介；下方独立下载日志（只显示本书批次）+ 主行动按钮。
    参数来源：docs/20261017_PCL2界面视觉规格_v1.0.md C/E/D 节：
      窗口内边距 25；三张无边框卡片（圆角 5 / 紧阴影 / 40 高标题行）；
      字号阶梯：标题 19（15~19 区间）、正文 13、说明 12；主按钮 52 高胶囊。
    纪律：不在构造里同步调 Python（Loaded + await）；加载失败显示 error_code + error_message，不崩。
    所有控件 x:Name 保持不变。
-->
<Window x:Class="JML.Pages.DetailWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ctl="clr-namespace:JML.Controls"
        Title="本子详情"
        Height="700" Width="820"
        MinWidth="640" MinHeight="600"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource JmlPageBackground}"
        Foreground="{DynamicResource ColorBrush1}">
    <Grid Margin="25">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="170" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 基本信息卡片 -->
        <ctl:JmlCard x:Name="CardInfo" Grid.Row="0" Header="本子信息">
            <Grid>
                <Grid x:Name="InfoPanel">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!-- 封面：加载中占位 → 图片；失败显示暗红底 X -->
                    <Grid Width="140" Height="192" VerticalAlignment="Top">
                        <Border x:Name="CoverPlaceholder"
                                Background="{DynamicResource ColorBrushGray7}"
                                CornerRadius="4">
                            <TextBlock Text="加载中…"
                                       FontSize="12"
                                       Foreground="{DynamicResource ColorBrushGray3}"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center" />
                        </Border>
                        <Border x:Name="CoverFailure"
                                Background="{DynamicResource ColorBrushRedBack}"
                                CornerRadius="4"
                                Visibility="Collapsed">
                            <TextBlock Text="X"
                                       FontSize="64" FontWeight="Bold"
                                       Foreground="{DynamicResource ColorBrushRedLight}"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center" />
                        </Border>
                        <Image x:Name="CoverImage"
                               Stretch="UniformToFill"
                               Visibility="Collapsed" />
                    </Grid>

                    <!-- 标题 19 / 正文 13 / 说明 12（PCL2 D2 字号阶梯） -->
                    <StackPanel Grid.Column="1" Margin="16,0,0,0">
                        <TextBlock x:Name="TextTitle"
                                   FontSize="19" FontWeight="Bold"
                                   TextWrapping="Wrap"
                                   Foreground="{DynamicResource ColorBrush1}" />
                        <TextBlock Margin="0,8,0,0" FontSize="13">
                            <Run Text="作者：" Foreground="{DynamicResource ColorBrushGray3}" /><Run x:Name="RunAuthor" Foreground="{DynamicResource ColorBrush1}" />
                        </TextBlock>
                        <TextBlock Margin="0,4,0,0" FontSize="13">
                            <Run Text="页数：" Foreground="{DynamicResource ColorBrushGray3}" /><Run x:Name="RunPageCount" Foreground="{DynamicResource ColorBrush1}" />
                        </TextBlock>

                        <TextBlock Text="标签：" Margin="0,10,0,0"
                                   FontSize="12"
                                   Foreground="{DynamicResource ColorBrushGray3}" />
                        <ItemsControl x:Name="TagItems" Margin="0,4,0,0">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{DynamicResource ColorBrushGray7}"
                                            BorderBrush="{DynamicResource ColorBrushGray6}"
                                            BorderThickness="1"
                                            CornerRadius="3"
                                            Padding="6,2" Margin="0,0,6,6">
                                        <TextBlock Text="{Binding}"
                                                   FontSize="12"
                                                   Foreground="{DynamicResource ColorBrush2}" />
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Grid>

                <!-- 加载失败：error_code + error_message（不崩） -->
                <StackPanel x:Name="ErrorPanel"
                            Visibility="Collapsed"
                            VerticalAlignment="Center">
                    <TextBlock Text="加载失败"
                               FontSize="15" FontWeight="SemiBold"
                               Foreground="{DynamicResource ColorBrushError}" />
                    <TextBlock x:Name="TextError"
                               Margin="0,6,0,0"
                               TextWrapping="Wrap"
                               Foreground="{DynamicResource ColorBrushError}" />
                </StackPanel>
            </Grid>
        </ctl:JmlCard>

        <!-- 简介（Python 已按 200 字截断，这里直接显示，不再截断） -->
        <ctl:JmlCard x:Name="CardDescription" Grid.Row="1" Header="简介" Margin="0,12,0,0">
            <ScrollViewer VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <TextBlock x:Name="TextDescription"
                           TextWrapping="Wrap"
                           FontSize="13"
                           Foreground="{DynamicResource ColorBrush1}" />
            </ScrollViewer>
        </ctl:JmlCard>

        <!-- 独立下载日志区：只显示本书所属批次 -->
        <ctl:JmlCard x:Name="CardLog" Grid.Row="2" Header="下载日志（本书批次）" Margin="0,12,0,0">
            <TextBox x:Name="LogBox"
                     Style="{StaticResource PlainTextBox}"
                     IsReadOnly="True"
                     AcceptsReturn="True"
                     TextWrapping="Wrap"
                     VerticalScrollBarVisibility="Auto"
                     HorizontalScrollBarVisibility="Disabled"
                     VerticalContentAlignment="Top"
                     FontFamily="Consolas" FontSize="12" />
        </ctl:JmlCard>

        <!-- 操作：主行动按钮 52 高胶囊 + 状态说明 -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,15,0,0">
            <Button x:Name="BtnDownload" Content="下载本子"
                    Style="{StaticResource PrimaryButton}"
                    Click="BtnDownload_Click" />
            <TextBlock x:Name="TextStatus"
                       VerticalAlignment="Center" Margin="16,0,0,0"
                       FontSize="12"
                       TextWrapping="Wrap"
                       Foreground="{DynamicResource ColorBrushGray3}" />
        </StackPanel>
    </Grid>
</Window>
