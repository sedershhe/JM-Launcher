<!--
    详情窗（阶段 2-C）
    展示：封面、标题、作者、页数、标签（WrapPanel + 样式化标签）、简介（直接显示 Python 给的 description）。
    下载：「下载本子」交给 MainWindow 切到下载页并开始；本窗的日志区只显示本书所属批次（按 batch_id 过滤）。
    纪律：不在构造里同步调 Python（Loaded + await）；加载失败显示 error_code + error_message，不崩。
-->
<Window x:Class="JML.Pages.DetailWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="本子详情"
        Height="700" Width="820"
        MinWidth="640" MinHeight="540"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource ColorBrushBackground}"
        Foreground="{DynamicResource ColorBrush1}">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="190" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 基本信息
             注意：PlainCard 模板的 ContentPresenter 用 TemplateBinding 跟随
             HorizontalContentAlignment / VerticalContentAlignment（WPF 默认 Left/Top），
             本窗三张卡片都必须显式设 Stretch，否则内容按期望尺寸靠左上收缩。 -->
        <ContentControl Grid.Row="0" Style="{StaticResource PlainCard}"
                        HorizontalContentAlignment="Stretch"
                        VerticalContentAlignment="Stretch">
            <Grid>
                <Grid x:Name="InfoPanel">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!-- 封面：加载中占位 → 图片；失败显示暗红底 X -->
                    <Grid Width="160" Height="220" VerticalAlignment="Top">
                        <Border x:Name="CoverPlaceholder"
                                Background="{DynamicResource ColorBrushGray7}"
                                CornerRadius="4">
                            <TextBlock Text="加载中…"
                                       FontSize="12"
                                       Foreground="{DynamicResource ColorBrushGray3}"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center" />
                        </Border>
                        <Border x:Name="CoverFailure"
                                Background="{DynamicResource ColorBrushRedBack}"
                                CornerRadius="4"
                                Visibility="Collapsed">
                            <TextBlock Text="X"
                                       FontSize="72" FontWeight="Bold"
                                       Foreground="{DynamicResource ColorBrushRedLight}"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center" />
                        </Border>
                        <Image x:Name="CoverImage"
                               Stretch="UniformToFill"
                               Visibility="Collapsed" />
                    </Grid>

                    <StackPanel Grid.Column="1" Margin="16,0,0,0">
                        <TextBlock x:Name="TextTitle"
                                   FontSize="18" FontWeight="Bold"
                                   TextWrapping="Wrap"
                                   Foreground="{DynamicResource ColorBrush1}" />
                        <TextBlock Margin="0,8,0,0" Foreground="{DynamicResource ColorBrushGray2}">
                            <Run Text="作者：" /><Run x:Name="RunAuthor" />
                        </TextBlock>
                        <TextBlock Margin="0,4,0,0" Foreground="{DynamicResource ColorBrushGray2}">
                            <Run Text="页数：" /><Run x:Name="RunPageCount" />
                        </TextBlock>

                        <TextBlock Text="标签：" Margin="0,10,0,0"
                                   Foreground="{DynamicResource ColorBrushGray2}" />
                        <ItemsControl x:Name="TagItems" Margin="0,4,0,0">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{DynamicResource ColorBrushGray7}"
                                            BorderBrush="{DynamicResource ColorBrushGray6}"
                                            BorderThickness="1"
                                            CornerRadius="3"
                                            Padding="6,2" Margin="0,0,6,6">
                                        <TextBlock Text="{Binding}"
                                                   FontSize="12"
                                                   Foreground="{DynamicResource ColorBrush2}" />
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Grid>

                <!-- 加载失败：error_code + error_message（不崩） -->
                <StackPanel x:Name="ErrorPanel"
                            Visibility="Collapsed"
                            VerticalAlignment="Center">
                    <TextBlock Text="加载失败"
                               FontSize="15" FontWeight="SemiBold"
                               Foreground="{DynamicResource ColorBrushError}" />
                    <TextBlock x:Name="TextError"
                               Margin="0,6,0,0"
                               TextWrapping="Wrap"
                               Foreground="{DynamicResource ColorBrushError}" />
                </StackPanel>
            </Grid>
        </ContentControl>

        <!-- 简介（Python 已按 200 字截断，这里直接显示，不再截断） -->
        <ContentControl Grid.Row="1" Style="{StaticResource PlainCard}" Margin="0,12,0,0"
                        HorizontalContentAlignment="Stretch"
                        VerticalContentAlignment="Stretch">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <TextBlock Text="简介" FontWeight="SemiBold" Margin="0,0,0,8" />
                <ScrollViewer Grid.Row="1"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <TextBlock x:Name="TextDescription"
                               TextWrapping="Wrap"
                               Foreground="{DynamicResource ColorBrush1}" />
                </ScrollViewer>
            </Grid>
        </ContentControl>

        <!-- 独立下载日志区：只显示本书所属批次 -->
        <ContentControl Grid.Row="2" Style="{StaticResource PlainCard}" Margin="0,12,0,0"
                        HorizontalContentAlignment="Stretch"
                        VerticalContentAlignment="Stretch">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <TextBlock Text="下载日志（本书批次）" FontWeight="SemiBold" Margin="0,0,0,8" />
                <TextBox x:Name="LogBox" Grid.Row="1"
                         Style="{StaticResource PlainTextBox}"
                         IsReadOnly="True"
                         AcceptsReturn="True"
                         TextWrapping="Wrap"
                         VerticalScrollBarVisibility="Auto"
                         HorizontalScrollBarVisibility="Disabled"
                         VerticalContentAlignment="Top"
                         MinHeight="100"
                         FontFamily="Consolas" FontSize="12" />
            </Grid>
        </ContentControl>

        <!-- 操作 -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,12,0,0">
            <Button x:Name="BtnDownload" Content="下载本子"
                    MinWidth="110" Click="BtnDownload_Click" />
            <TextBlock x:Name="TextStatus"
                       VerticalAlignment="Center" Margin="12,0,0,0"
                       TextWrapping="Wrap"
                       Foreground="{DynamicResource ColorBrushGray3}" />
        </StackPanel>
    </Grid>
</Window>
