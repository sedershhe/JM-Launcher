<!--
    下载页（阶段 2-C，2026-10-17 页面层 PCL2 化）
    布局：上方输入区卡片 → 下方日志卡片（间距 12）；页面外边距 25,10,25,25（PCL2 PageDownloadInstall.xaml:10）。
    参数来源：docs/20261017_PCL2界面视觉规格_v1.0.md C/E 节。
    纪律：
      1) 编号分隔符/去重/合法性、下载目录校验、产物命名、成功失败统计全部由 Python 决定；
      2) 日志只显示本批次（空 batch_id 的全局日志同样显示），自动滚到底；
      3) 桥接调用一律 await，本文件不含任何业务逻辑；
      4) 所有控件 x:Name 保持不变（测试与代码后置依赖）。
-->
<UserControl x:Class="JML.Pages.DownloadPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ctl="clr-namespace:JML.Controls">
    <Grid Margin="25,10,25,25">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- 上方：输入与操作区（PCL2 无边框卡片 + 40 高标题行） -->
        <ctl:JmlCard x:Name="CardInput" Grid.Row="0"
                     Header="批量下载"
                     VerticalAlignment="Top">
            <StackPanel>
                <TextBlock Text="支持一次输入多个本子编号，分隔符：- , ， 、 ; ； 或任意空白（例如 123456,234567，345678）。"
                           Margin="0,0,0,12"
                           TextWrapping="Wrap"
                           Foreground="{DynamicResource ColorBrushGray3}" />

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="本子编号：" VerticalAlignment="Center" Margin="0,0,8,0" />
                    <TextBox x:Name="InputIds" Grid.Column="1"
                             Style="{StaticResource JmlInputBox}"
                             MinHeight="32"
                             ToolTip="可一次填多个编号，用 - , ， 、 ; ； 或空格分隔" />
                </Grid>

                <Grid Margin="0,10,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="保存目录：" VerticalAlignment="Center" Margin="0,0,8,0" />
                    <TextBox x:Name="InputDir" Grid.Column="1"
                             Style="{StaticResource JmlInputBox}"
                             MinHeight="32"
                             IsReadOnly="True" />
                    <Button x:Name="BtnBrowse" Grid.Column="2" Content="浏览…"
                            Style="{StaticResource SecondaryButton}"
                            Margin="8,0,0,0" Click="BtnBrowse_Click" />
                </Grid>

                <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                    <Button x:Name="BtnStart" Content="开始下载"
                            Style="{StaticResource PrimaryButton}"
                            Click="BtnStart_Click" />
                    <Button x:Name="BtnCancel" Content="取消"
                            Style="{StaticResource SecondaryButton}"
                            Margin="10,0,0,0"
                            VerticalAlignment="Center"
                            IsEnabled="False" Click="BtnCancel_Click" />
                </StackPanel>

                <TextBlock x:Name="TextStatus" Margin="0,10,0,0"
                           TextWrapping="Wrap"
                           Foreground="{DynamicResource ColorBrushGray3}" />
            </StackPanel>
        </ctl:JmlCard>

        <!-- 下方：日志卡片（只读、自动滚到底）；与输入卡间距 12（PCL2 PageDownloadInstall.xaml:30） -->
        <ctl:JmlCard x:Name="CardLog" Grid.Row="1"
                     Header="下载日志（本批次）"
                     Margin="0,12,0,0">
            <TextBox x:Name="LogBox"
                     Style="{StaticResource PlainTextBox}"
                     IsReadOnly="True"
                     AcceptsReturn="True"
                     TextWrapping="Wrap"
                     VerticalScrollBarVisibility="Auto"
                     HorizontalScrollBarVisibility="Disabled"
                     VerticalContentAlignment="Top"
                     MinHeight="100"
                     FontFamily="Consolas" FontSize="12" />
        </ctl:JmlCard>
    </Grid>
</UserControl>
