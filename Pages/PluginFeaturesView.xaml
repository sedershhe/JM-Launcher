<!--
    插件功能视图（阶段 4：结构化页面协议入口，2026-10-18）
    ============================================================
    数据来源与插件管理视图一致：PluginBridge.Bootstrap。
    列表项 = **已启用插件**（不是单页）。双击某个插件：
      - 只声明 1 个页面 → 直接进入该功能页（PluginPageHost 渲染）；
      - 声明多个页面 → 先在本视图内显示页面选择列表，再进入；
      - 未声明页面 → 状态行给出明确提示。
    进入功能页仍走 MainWindow 的内页机制（NavigationStack.PushInner）。
-->
<UserControl x:Class="JML.Pages.PluginFeaturesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid>
            <!-- 插件列表 -->
            <DockPanel x:Name="PanelPlugins">
                <TextBlock DockPanel.Dock="Top"
                           Text="已启用插件（双击进入功能页）"
                           FontSize="13"
                           FontWeight="SemiBold"
                           Margin="0,0,0,6"
                           Foreground="{DynamicResource ColorBrush1}" />
                <ListBox x:Name="FeatureList"
                         MouseDoubleClick="FeatureList_MouseDoubleClick">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Margin="4,2">
                                <TextBlock Text="{Binding PluginName}" FontSize="14" FontWeight="SemiBold" />
                                <TextBlock Text="{Binding Summary}"
                                           FontSize="12"
                                           Foreground="{DynamicResource ColorBrushGray3}" />
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>

            <!-- 多页面插件的页面选择列表 -->
            <DockPanel x:Name="PanelPages" Visibility="Collapsed">
                <StackPanel DockPanel.Dock="Top"
                            Orientation="Horizontal"
                            Margin="0,0,0,6">
                    <Button x:Name="BtnPagesBack"
                            Content="返回插件列表"
                            Style="{StaticResource SecondaryButton}"
                            MinWidth="110"
                            Click="BtnPagesBack_Click" />
                    <TextBlock x:Name="TextPagesTitle"
                               VerticalAlignment="Center"
                               Margin="12,0"
                               FontSize="13"
                               Foreground="{DynamicResource ColorBrushGray3}" />
                </StackPanel>
                <ListBox x:Name="PageList"
                         MouseDoubleClick="PageList_MouseDoubleClick">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Margin="4,2">
                                <TextBlock Text="{Binding Title}" FontSize="14" FontWeight="SemiBold" />
                                <TextBlock Text="{Binding Template}"
                                           FontSize="12"
                                           Foreground="{DynamicResource ColorBrushGray3}" />
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </Grid>

        <TextBlock x:Name="TextStatus" Grid.Row="1"
                   Margin="0,8,0,0"
                   Foreground="{DynamicResource ColorBrushGray3}"
                   TextWrapping="Wrap" />
    </Grid>
</UserControl>
