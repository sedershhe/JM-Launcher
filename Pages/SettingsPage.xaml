<!--
    设置页（阶段 3：账号 + 下载路径接线）
    分区：账号设置、下载路径、插件设置（阶段 4）。
    安全：账号凭据不进本页配置；本页只显示打码用户名与固定提示。
    布局修复保留：外层 ScrollViewer 必须禁用横向滚动，否则纵向 StackPanel 在
    无限宽测量下让 * 列塌成内容宽（实测 InputDownloadDir 只有 6×36）；
    卡片内容由 JmlCard 模板统一 Stretch，不再依赖 PlainCard 的 ContentPresenter 默认 Left。
-->
<UserControl x:Class="JML.Pages.SettingsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ctl="clr-namespace:JML.Controls">
    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled"
                  HorizontalContentAlignment="Stretch">
        <StackPanel Margin="25">

            <!-- 账号设置：只显示状态与入口，真实录入在模态 AccountDialog -->
            <ctl:JmlCard x:Name="CardAccount" Header="账号设置" HorizontalAlignment="Stretch">
                <StackPanel>
                    <TextBlock x:Name="TextAccountStatus"
                               Text="未登录"
                               FontSize="15"
                               FontWeight="SemiBold"
                               TextWrapping="Wrap"
                               Foreground="{DynamicResource ColorBrush1}" />
                    <TextBlock Margin="0,6,0,10"
                               Text="账号凭据保存在 Windows 凭据管理器；不可用时回退到 DPAPI 加密文件，不会写入 settings.json 或日志。启动时不会自动登录，可按需使用已保存账号登录。"
                               TextWrapping="Wrap"
                               Foreground="{DynamicResource ColorBrushGray3}" />
                    <StackPanel Orientation="Horizontal">
                        <Button x:Name="BtnAccount"
                                Content="登录 / 管理账号"
                                Style="{StaticResource SecondaryButton}"
                                HorizontalAlignment="Left"
                                Click="BtnAccount_Click" />
                        <!-- 有保存凭据但未登录时才显示：重启后免重输密码。 -->
                        <Button x:Name="BtnLoginSaved"
                                Content="使用已保存账号登录"
                                Margin="8,0,0,0"
                                Visibility="Collapsed"
                                Style="{StaticResource SecondaryButton}"
                                Click="BtnLoginSaved_Click" />
                    </StackPanel>
                </StackPanel>
            </ctl:JmlCard>

            <!-- 下载路径：选择后持久化到 AppSettings（只存路径） -->
            <ctl:JmlCard x:Name="CardPath" Header="下载路径" Margin="0,12,0,0" HorizontalAlignment="Stretch">
                <StackPanel>
                    <TextBlock Text="记住上次选择的目录；下载页默认使用该目录，目录不存在时回退桌面。"
                               Margin="0,0,0,10"
                               TextWrapping="Wrap"
                               Foreground="{DynamicResource ColorBrushGray3}" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="InputDownloadDir"
                                 Style="{StaticResource JmlInputBox}"
                                 MinHeight="32"
                                 IsReadOnly="True" />
                        <Button x:Name="BtnBrowseDir" Grid.Column="1" Content="浏览…"
                                Margin="8,0,0,0"
                                Style="{StaticResource SecondaryButton}"
                                Click="BtnBrowseDir_Click" />
                    </Grid>
                </StackPanel>
            </ctl:JmlCard>

            <!-- 数据目录：只读展示当前选中的根；降级时给出明确提示，
                 不提供切换入口（根在启动时解析一次，改根需重启）。 -->
            <ctl:JmlCard x:Name="CardDataRoot" Header="数据目录" Margin="0,12,0,0" HorizontalAlignment="Stretch">
                <StackPanel>
                    <TextBlock x:Name="TextDataRoot"
                               Text="配置：—&#x0a;数据：—&#x0a;插件数据：—"
                               TextWrapping="Wrap"
                               Foreground="{DynamicResource ColorBrush1}" />
                    <TextBlock x:Name="TextDataRootHint"
                               Visibility="Collapsed"
                               Margin="0,6,0,0"
                               TextWrapping="Wrap"
                               Foreground="{DynamicResource ColorBrushError}" />
                </StackPanel>
            </ctl:JmlCard>

            <!-- 插件设置：按已加载插件的 manifest config.schema 动态生成字段（任务 3-B）。
                 字段控件由 Pages\SettingsPage.PluginSettings.cs 运行时创建，
                 这里只留空态文字 / 错误行 / 字段容器 / 保存按钮，样式全部复用现有资源。 -->
            <ctl:JmlCard x:Name="CardPlugin" Header="插件设置" Margin="0,12,0,0" HorizontalAlignment="Stretch">
                <StackPanel>
                    <TextBlock x:Name="TextPluginEmpty"
                               Text="正在加载插件设置…"
                               TextWrapping="Wrap"
                               Foreground="{DynamicResource ColorBrushGray3}" />
                    <TextBlock x:Name="TextPluginError"
                               Visibility="Collapsed"
                               Margin="0,6,0,0"
                               TextWrapping="Wrap"
                               Foreground="{DynamicResource ColorBrushError}" />
                    <StackPanel x:Name="PanelPluginSettings" />
                    <Button x:Name="BtnSavePluginSettings"
                            Content="保存"
                            Margin="0,6,0,0"
                            Visibility="Collapsed"
                            HorizontalAlignment="Left"
                            Style="{StaticResource SecondaryButton}"
                            Click="BtnSavePluginSettings_Click" />
                </StackPanel>
            </ctl:JmlCard>

        </StackPanel>
    </ScrollViewer>
</UserControl>
