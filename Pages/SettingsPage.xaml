<!--
    设置页（阶段 1：仅界面框架）
    分区：账号设置（阶段 3）、下载路径（阶段 3）、插件设置（占位）。
    所有控件在阶段 1 不接业务事件。
-->
<UserControl x:Class="JML.Pages.SettingsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="16">

            <!-- 账号设置（阶段 3 实现；账号凭据走安全存储，不入配置文件） -->
            <ContentControl Style="{StaticResource PlainCard}">
                <StackPanel>
                    <TextBlock Text="账号设置" FontSize="15" FontWeight="SemiBold" />
                    <TextBlock Text="账号登录与凭据管理将在阶段 3 实现（凭据走安全存储，不写入配置文件）。"
                               Margin="0,4,0,10"
                               Foreground="{DynamicResource ColorBrushGray3}" />
                    <Button x:Name="BtnAccount" Content="登录 / 管理账号" IsEnabled="False"
                            HorizontalAlignment="Left" />
                </StackPanel>
            </ContentControl>

            <!-- 下载路径（阶段 3 接入保存逻辑） -->
            <ContentControl Style="{StaticResource PlainCard}" Margin="0,12,0,0">
                <StackPanel>
                    <TextBlock Text="下载路径" FontSize="15" FontWeight="SemiBold" />
                    <Grid Margin="0,10,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="InputDownloadDir" IsReadOnly="True" />
                        <Button x:Name="BtnBrowseDir" Grid.Column="1" Content="浏览…"
                                Margin="8,0,0,0" IsEnabled="False" />
                    </Grid>
                </StackPanel>
            </ContentControl>

            <!-- 插件设置（占位：插件提供的设置项在阶段 4 动态生成） -->
            <ContentControl Style="{StaticResource PlainCard}" Margin="0,12,0,0">
                <StackPanel>
                    <TextBlock Text="插件设置" FontSize="15" FontWeight="SemiBold" />
                    <TextBlock Text="已加载插件提供的设置项将在此动态展示（阶段 4 实现）。"
                               Margin="0,4,0,0"
                               Foreground="{DynamicResource ColorBrushGray3}" />
                </StackPanel>
            </ContentControl>

        </StackPanel>
    </ScrollViewer>
</UserControl>
