<!--
    设置页（阶段 1：仅界面框架；2026-10-17 页面层 PCL2 化只改外观）
    分区：账号设置（阶段 3）、下载路径（阶段 3）、插件设置（占位）。
    所有控件在阶段 1 不接业务事件。
    布局修复：外层 ScrollViewer 必须禁用横向滚动，否则纵向 StackPanel 在
    无限宽测量下让 * 列塌成内容宽（实测 InputDownloadDir 只有 6×36）；
    卡片内容由 JmlCard 模板统一 Stretch，不再依赖 PlainCard 的 ContentPresenter 默认 Left。
-->
<UserControl x:Class="JML.Pages.SettingsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ctl="clr-namespace:JML.Controls">
    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled"
                  HorizontalContentAlignment="Stretch">
        <StackPanel Margin="25">

            <!-- 账号设置（阶段 3 实现；账号凭据走安全存储，不入配置文件） -->
            <ctl:JmlCard x:Name="CardAccount" Header="账号设置" HorizontalAlignment="Stretch">
                <StackPanel>
                    <TextBlock Text="账号登录与凭据管理将在阶段 3 实现（凭据走安全存储，不写入配置文件）。"
                               Margin="0,0,0,10"
                               Foreground="{DynamicResource ColorBrushGray3}" />
                    <Button x:Name="BtnAccount" Content="登录 / 管理账号" IsEnabled="False"
                            Style="{StaticResource SecondaryButton}"
                            HorizontalAlignment="Left" />
                </StackPanel>
            </ctl:JmlCard>

            <!-- 下载路径（阶段 3 接入保存逻辑） -->
            <ctl:JmlCard x:Name="CardPath" Header="下载路径" Margin="0,12,0,0" HorizontalAlignment="Stretch">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="InputDownloadDir"
                             Style="{StaticResource JmlInputBox}"
                             MinHeight="32"
                             IsReadOnly="True" />
                    <Button x:Name="BtnBrowseDir" Grid.Column="1" Content="浏览…"
                            Margin="8,0,0,0" IsEnabled="False"
                            Style="{StaticResource SecondaryButton}" />
                </Grid>
            </ctl:JmlCard>

            <!-- 插件设置（占位：插件提供的设置项在阶段 4 动态生成） -->
            <ctl:JmlCard x:Name="CardPlugin" Header="插件设置" Margin="0,12,0,0" HorizontalAlignment="Stretch">
                <StackPanel>
                    <TextBlock Text="已加载插件提供的设置项将在此动态展示（阶段 4 实现）。"
                               Margin="0,0,0,0"
                               Foreground="{DynamicResource ColorBrushGray3}" />
                </StackPanel>
            </ctl:JmlCard>

        </StackPanel>
    </ScrollViewer>
</UserControl>
