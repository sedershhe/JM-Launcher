<!--
    插件页主体（阶段 1）
    左侧栏（宽 160）：插件管理 / 插件功能 两个选项；右侧为对应内容视图。
    顶部返回栏由 MainWindow 统一处理，本页只负责栏内切换。
-->
<UserControl x:Class="JML.Pages.PluginHubPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="160" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- 左侧栏 -->
        <Border Grid.Column="0"
                Background="{DynamicResource ColorBrushBackground}"
                BorderBrush="{DynamicResource ColorBrushGray6}"
                BorderThickness="0,0,1,0">
            <StackPanel Margin="8,12">
                <RadioButton x:Name="TabManage" Content="插件管理"
                             Style="{StaticResource SideListItem}"
                             IsChecked="True" Checked="Tab_Checked" />
                <RadioButton x:Name="TabFeatures" Content="插件功能"
                             Style="{StaticResource SideListItem}"
                             Margin="0,4,0,0" Checked="Tab_Checked" />
            </StackPanel>
        </Border>

        <!-- 右侧内容区 -->
        <ContentControl x:Name="ContentArea" Grid.Column="1" />
    </Grid>
</UserControl>
