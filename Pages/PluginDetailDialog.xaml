<!--
    插件详情窗（2026-10-18，缺陷 2 修复）
    ============================================================
    双击插件管理列表的一行打开：展示名称 / id / 版本 / 状态 / 完整说明
    （多行、可滚动）/ 功能页 / 依赖插件 / 提供与所需服务 / 失败原因，
    并按当前状态只显示「启用」或「停用」中的一个。

    数据来源：
      - 状态、说明、dependents：Python get_plugin_management_state；
      - 功能页 / 依赖 / 服务：Bridge.PluginManifestReader 只读 plugin.json
        （仅展示，不参与加载与启停判断）；
      - 启用/停用：现有 PluginManageBridge.SetPluginEnabled。
    样式复用现有对话框：浅色页面底 + JmlCard + PrimaryButton/SecondaryButton。
-->
<Window x:Class="JML.Pages.PluginDetailDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ctl="clr-namespace:JML.Controls"
        Title="插件详情"
        Width="520" Height="420"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="{StaticResource JmlPageBackground}"
        Foreground="{DynamicResource ColorBrush1}"
        FontFamily="Microsoft YaHei UI"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">
    <Window.Resources>
        <!-- 操作成功用绿色；失败沿用主题已有的 ColorBrushError。 -->
        <SolidColorBrush x:Key="DialogSuccessBrush" Color="#1A7F37" />

        <Style x:Key="DetailLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Margin" Value="0,10,0,4" />
            <Setter Property="Foreground" Value="{DynamicResource ColorBrushGray3}" />
        </Style>

        <Style x:Key="DetailText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Foreground" Value="{DynamicResource ColorBrush1}" />
        </Style>
    </Window.Resources>

    <Grid Margin="20,16,20,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 标题：名称 + id/版本 -->
        <StackPanel Grid.Row="0">
            <TextBlock x:Name="TextName"
                       FontSize="19"
                       FontWeight="Bold"
                       TextWrapping="Wrap"
                       Foreground="{DynamicResource ColorBrush1}" />
            <TextBlock x:Name="TextIdVersion"
                       Margin="0,4,0,0"
                       FontSize="12"
                       TextWrapping="Wrap"
                       Foreground="{DynamicResource ColorBrushGray3}" />
        </StackPanel>

        <!-- 信息卡片：整块可滚动；说明区单独可滚动，保证完整多行可见 -->
        <ctl:JmlCard x:Name="CardDetail"
                     Grid.Row="1"
                     Header="插件信息"
                     Margin="0,10,0,0">
            <ScrollViewer VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <StackPanel Margin="0,0,6,0">
                    <TextBlock Text="状态" Style="{StaticResource DetailLabel}" />
                    <TextBlock x:Name="TextStatus" Style="{StaticResource DetailText}" />

                    <TextBlock Text="说明" Style="{StaticResource DetailLabel}" />
                    <ScrollViewer x:Name="ScrollDescription"
                                  Height="88"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled">
                        <TextBlock x:Name="TextDescription"
                                   Style="{StaticResource DetailText}" />
                    </ScrollViewer>

                    <TextBlock Text="功能页" Style="{StaticResource DetailLabel}" />
                    <TextBlock x:Name="TextPages" Style="{StaticResource DetailText}" />

                    <TextBlock Text="依赖插件" Style="{StaticResource DetailLabel}" />
                    <TextBlock x:Name="TextDependencies" Style="{StaticResource DetailText}" />

                    <TextBlock Text="提供 / 所需服务" Style="{StaticResource DetailLabel}" />
                    <TextBlock x:Name="TextServices" Style="{StaticResource DetailText}" />

                    <!-- 只在加载失败时显示失败原因 -->
                    <StackPanel x:Name="PanelFailureReason" Visibility="Collapsed">
                        <TextBlock Text="失败原因" Style="{StaticResource DetailLabel}" />
                        <TextBlock x:Name="TextFailureReason"
                                   Style="{StaticResource DetailText}"
                                   Foreground="{DynamicResource ColorBrushError}" />
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </ctl:JmlCard>

        <!-- 操作结果：失败红字 [错误码] 原因；成功绿字 -->
        <TextBlock x:Name="TextDialogStatus"
                   Grid.Row="2"
                   Margin="0,8,0,0"
                   MinHeight="18"
                   FontSize="12"
                   TextWrapping="Wrap" />

        <!-- 按钮：按状态只显示「启用」或「停用」中可用的一个；关闭始终可用 -->
        <Grid Grid.Row="3" Margin="0,10,0,0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                <Button x:Name="BtnEnable"
                        Content="启用"
                        MinWidth="88"
                        Visibility="Collapsed"
                        Style="{StaticResource PrimaryButton}"
                        Click="BtnEnable_Click" />
                <Button x:Name="BtnDisable"
                        Content="停用"
                        MinWidth="88"
                        Visibility="Collapsed"
                        Style="{StaticResource SecondaryButton}"
                        Click="BtnDisable_Click" />
            </StackPanel>
            <Button x:Name="BtnClose"
                    Content="关闭"
                    MinWidth="88"
                    HorizontalAlignment="Right"
                    Style="{StaticResource SecondaryButton}"
                    Click="BtnClose_Click" />
        </Grid>
    </Grid>
</Window>
