<!--
    插件结构化页面宿主（技术方案第三节方案 A，2026-10-18）
    ============================================================
    本页是**模板渲染器**，不含任何业务逻辑：模板类型、页面标题、列定义、
    行数据、文件清单、状态文案、动作按钮、失败判断全部来自 Python
    （plugin_page_load / plugin_page_action），C# 只按 template 选控件：
      list    → DataGrid（列 = columns，行 = rows，行操作 = row_actions）+ 分页 + 空态
      browser → 左侧文件列表 + 右侧图片区（plugin_page_image 原始 bytes）+ 图片分页 + 返回
      action  → 文件列表 + actions 动作按钮 + status_text + 刷新
    插件**不允许**返回任意 XAML / 界面描述，未知模板只显示错误文案。

    顶部「← 返回 + 页面名」仍由 MainWindow 的内页标题栏负责
    （NavigationStack.PushInner / PopInner），本页只渲染内容区。
-->
<UserControl x:Class="JML.Pages.PluginPageHost"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Focusable="True"
             KeyDown="Host_KeyDown">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- 状态行（动作 message 等）与协议/动作失败行；失败显示 [error_code] error_message -->
        <StackPanel Grid.Row="0" Margin="0,0,0,8">
            <TextBlock x:Name="TextStatus"
                       Visibility="Collapsed"
                       TextWrapping="Wrap"
                       FontSize="13"
                       Foreground="{DynamicResource ColorBrushGray3}" />
            <TextBlock x:Name="TextError"
                       Visibility="Collapsed"
                       TextWrapping="Wrap"
                       FontSize="13"
                       Foreground="{DynamicResource ColorBrushError}" />
        </StackPanel>

        <Grid Grid.Row="1">

            <!-- ================= list 模板 ================= -->
            <Grid x:Name="PanelList" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <DataGrid x:Name="GridRows"
                          Style="{StaticResource JmlDataGrid}"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          CanUserAddRows="False"
                          CanUserDeleteRows="False"
                          CanUserSortColumns="False"
                          CanUserReorderColumns="False"
                          SelectionMode="Single"
                          HeadersVisibility="Column" />

                <TextBlock x:Name="TextListEmpty"
                           Visibility="Collapsed"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           FontSize="13"
                           Foreground="{DynamicResource ColorBrushGray3}"
                           TextWrapping="Wrap" />

                <StackPanel x:Name="PanelListPager"
                            Grid.Row="1"
                            Orientation="Horizontal"
                            HorizontalAlignment="Right"
                            Margin="0,8,0,0">
                    <Button x:Name="BtnListPrev"
                            Content="上一页"
                            Style="{StaticResource SecondaryButton}"
                            MinWidth="76"
                            Click="BtnListPrev_Click" />
                    <TextBlock x:Name="TextListPage"
                               VerticalAlignment="Center"
                               Margin="12,0"
                               FontSize="13"
                               Foreground="{DynamicResource ColorBrushGray3}" />
                    <Button x:Name="BtnListNext"
                            Content="下一页"
                            Style="{StaticResource SecondaryButton}"
                            MinWidth="76"
                            Click="BtnListNext_Click" />
                </StackPanel>
            </Grid>

            <!-- ================= browser 模板 ================= -->
            <Grid x:Name="PanelBrowser" Visibility="Collapsed">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="240" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- 左：文件列表 + 列表分页 -->
                <DockPanel Grid.Column="0" Margin="0,0,12,0">
                    <StackPanel DockPanel.Dock="Top" Margin="0,0,0,6">
                        <TextBlock Text="文件"
                                   FontSize="13"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource ColorBrush1}" />
                        <!-- 文件夹选择：仅当 browser payload 的 allow_folder_choice 为真时显示
                             （ZIP 浏览插件用；C# 只负责选目录并把 folder 参数回传 Python） -->
                        <Button x:Name="BtnChooseFolder"
                                Content="选择文件夹…"
                                Style="{StaticResource SecondaryButton}"
                                HorizontalAlignment="Left"
                                MinWidth="120"
                                Margin="0,6,0,0"
                                Visibility="Collapsed"
                                Click="BtnChooseFolder_Click" />
                    </StackPanel>
                    <StackPanel x:Name="PanelFilePager"
                                DockPanel.Dock="Bottom"
                                Orientation="Horizontal"
                                HorizontalAlignment="Left"
                                Margin="0,8,0,0">
                        <Button x:Name="BtnFilePrev"
                                Content="上一页"
                                Style="{StaticResource SecondaryButton}"
                                MinWidth="64"
                                Click="BtnFilePrev_Click" />
                        <TextBlock x:Name="TextFilePage"
                                   VerticalAlignment="Center"
                                   Margin="8,0"
                                   FontSize="12"
                                   Foreground="{DynamicResource ColorBrushGray3}" />
                        <Button x:Name="BtnFileNext"
                                Content="下一页"
                                Style="{StaticResource SecondaryButton}"
                                MinWidth="64"
                                Click="BtnFileNext_Click" />
                    </StackPanel>
                    <ListBox x:Name="BrowserFileList"
                             MouseDoubleClick="BrowserFileList_MouseDoubleClick" />
                </DockPanel>

                <!-- 右：图片区 + 图片分页 + 返回 -->
                <Grid Grid.Column="1">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <StackPanel x:Name="PanelImageBar"
                                Grid.Row="0"
                                Orientation="Horizontal"
                                HorizontalAlignment="Right"
                                Margin="0,0,0,8">
                        <Button x:Name="BtnBrowserBack"
                                Content="返回列表"
                                Style="{StaticResource SecondaryButton}"
                                MinWidth="76"
                                Margin="0,0,12,0"
                                Click="BtnBrowserBack_Click" />
                        <Button x:Name="BtnImagePrev"
                                Content="上一页"
                                Style="{StaticResource SecondaryButton}"
                                MinWidth="76"
                                Click="BtnImagePrev_Click" />
                        <TextBlock x:Name="TextImagePage"
                                   VerticalAlignment="Center"
                                   Margin="12,0"
                                   FontSize="13"
                                   Foreground="{DynamicResource ColorBrushGray3}" />
                        <Button x:Name="BtnImageNext"
                                Content="下一页"
                                Style="{StaticResource SecondaryButton}"
                                MinWidth="76"
                                Click="BtnImageNext_Click" />
                    </StackPanel>

                    <Image x:Name="ImagePage"
                           Grid.Row="1"
                           Stretch="Uniform"
                           StretchDirection="DownOnly"
                           SnapsToDevicePixels="True" />

                    <TextBlock x:Name="TextImageHint"
                               Grid.Row="1"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               FontSize="13"
                               TextWrapping="Wrap"
                               Foreground="{DynamicResource ColorBrushGray3}" />

                    <TextBlock x:Name="TextBrowserEmpty"
                               Grid.Row="1"
                               Visibility="Collapsed"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               FontSize="13"
                               TextWrapping="Wrap"
                               Foreground="{DynamicResource ColorBrushGray3}" />
                </Grid>
            </Grid>

            <!-- ================= action 模板 ================= -->
            <Grid x:Name="PanelAction" Visibility="Collapsed">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="240" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- 左：文件列表 -->
                <DockPanel Grid.Column="0" Margin="0,0,12,0">
                    <TextBlock DockPanel.Dock="Top"
                               Text="文件"
                               FontSize="13"
                               FontWeight="SemiBold"
                               Margin="0,0,0,6"
                               Foreground="{DynamicResource ColorBrush1}" />
                    <ListBox x:Name="ActionFileList" />
                </DockPanel>

                <!-- 右：动作按钮 + 状态文案 + 刷新 -->
                <DockPanel Grid.Column="1" Margin="12,0,0,0">
                    <StackPanel DockPanel.Dock="Top"
                                Orientation="Horizontal"
                                HorizontalAlignment="Right"
                                Margin="0,0,0,8">
                        <Button x:Name="BtnActionRefresh"
                                Content="刷新"
                                Style="{StaticResource SecondaryButton}"
                                MinWidth="76"
                                Click="BtnActionRefresh_Click" />
                    </StackPanel>

                    <TextBlock x:Name="TextActionStatus"
                               DockPanel.Dock="Bottom"
                               Margin="0,8,0,0"
                               FontSize="13"
                               TextWrapping="Wrap"
                               Foreground="{DynamicResource ColorBrushGray3}" />

                    <Grid>
                        <StackPanel x:Name="PanelActionButtons"
                                    Orientation="Horizontal"
                                    VerticalAlignment="Top" />
                        <TextBlock x:Name="TextActionEmpty"
                                   Visibility="Collapsed"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   FontSize="13"
                                   TextWrapping="Wrap"
                                   Foreground="{DynamicResource ColorBrushGray3}" />
                    </Grid>
                </DockPanel>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
