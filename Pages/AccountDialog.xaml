<!--
    账号修改窗口（阶段 3，硬性要求：必须提供账号修改窗口）
    参数来源：功能计划书 4.8 / 11.2，技术方案第六章，桥接契约 §十。
    视觉：沿用现有页面底色 + 主题按钮/输入框，不自造新的视觉语言。
    安全：
      1) 密码使用 PasswordBox，永不回显；
      2) 打开时只显示已保存账号的打码用户名，密码框留空；
      3) 未点「保存并登录」不会改动原凭据；
      4) 错误文案经 LogSanitizer 脱敏后才展示，不显示密码；
      5) 「使用已保存账号登录」只在存在已保存凭据时可见；密码只经局部变量
         Load → SetCredentials → Login，成功后立即丢弃，不缓存到字段。
-->
<Window x:Class="JML.Pages.AccountDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="账号设置"
        Width="420" Height="430"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="{StaticResource JmlPageBackground}"
        Foreground="{DynamicResource ColorBrush1}"
        FontFamily="Microsoft YaHei UI"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">
    <Window.Resources>
        <!-- 登录成功用绿色；红色沿用主题已有的 ColorBrushError。 -->
        <SolidColorBrush x:Key="AccountSuccessBrush" Color="#1A7F37" />

        <Style x:Key="AccountTextBox" TargetType="TextBox" BasedOn="{StaticResource JmlInputBox}">
            <Setter Property="MinHeight" Value="32" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>

        <Style x:Key="AccountPasswordBox" TargetType="PasswordBox" BasedOn="{StaticResource PlainPasswordBox}">
            <Setter Property="Background" Value="{DynamicResource ColorBrushInputHoverBg}" />
            <Setter Property="MinHeight" Value="32" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
    </Window.Resources>

    <Grid Margin="20,16,20,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 保存状态提示：已保存账号显示“密码不再显示”，未保存显示引导。 -->
        <TextBlock x:Name="TextSavedHint"
                   Grid.Row="0"
                   FontSize="12"
                   TextWrapping="Wrap"
                   Foreground="{DynamicResource ColorBrushGray3}" />

        <!-- 用户名 / 密码（密码不回显） -->
        <Grid Grid.Row="1" Margin="0,8,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="60" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock Text="用户名"
                       VerticalAlignment="Center"
                       FontSize="13" />
            <TextBox x:Name="InputUsername"
                     Grid.Column="1"
                     Style="{StaticResource AccountTextBox}"
                     AutomationProperties.Name="用户名" />

            <TextBlock Grid.Row="1"
                       Text="密码"
                       Margin="0,8,0,0"
                       VerticalAlignment="Center"
                       FontSize="13" />
            <PasswordBox x:Name="InputPassword"
                         Grid.Row="1" Grid.Column="1"
                         Margin="0,8,0,0"
                         Style="{StaticResource AccountPasswordBox}"
                         AutomationProperties.Name="密码" />
        </Grid>

        <TextBlock Grid.Row="2"
                   Margin="0,8,0,0"
                   FontSize="12"
                   TextWrapping="Wrap"
                   Foreground="{DynamicResource ColorBrushGray3}"
                   Text="密码不会回显，也不会写入 settings.json、插件配置或日志。凭据优先保存到 Windows 凭据管理器，不可用时回退到 DPAPI 加密文件。" />

        <!-- 操作结果：成功绿字，失败红字 [error_code] error_message（已脱敏）。 -->
        <TextBlock x:Name="TextAccountStatus"
                   Grid.Row="3"
                   Margin="0,6,0,0"
                   MinHeight="18"
                   FontSize="12"
                   TextWrapping="Wrap"
                   Foreground="{DynamicResource ColorBrushError}" />

        <StackPanel Grid.Row="4"
                    Orientation="Horizontal"
                    Margin="0,10,0,0">
            <Button x:Name="BtnSaveLogin"
                    Content="保存并登录"
                    Style="{StaticResource PrimaryButton}"
                    MinWidth="140"
                    Click="BtnSaveLogin_Click" />
            <Button x:Name="BtnCancel"
                    Content="取消"
                    Margin="10,0,0,0"
                    VerticalAlignment="Center"
                    Style="{StaticResource SecondaryButton}"
                    Click="BtnCancel_Click" />
        </StackPanel>

        <StackPanel Grid.Row="5"
                    Orientation="Horizontal"
                    Margin="0,6,0,0">
            <!-- 只有存在已保存凭据时才显示：重启后无需重输密码即可登录。 -->
            <Button x:Name="BtnLoginSaved"
                    Content="使用已保存账号登录"
                    Visibility="Collapsed"
                    Style="{StaticResource SecondaryButton}"
                    Click="BtnLoginSaved_Click" />
        </StackPanel>

        <StackPanel Grid.Row="6"
                    Orientation="Horizontal"
                    Margin="0,6,0,0">
            <Button x:Name="BtnClearSaved"
                    Content="清除已保存账号"
                    IsEnabled="False"
                    Style="{StaticResource SecondaryButton}"
                    Click="BtnClearSaved_Click" />
            <Button x:Name="BtnLogout"
                    Content="登出"
                    Margin="10,0,0,0"
                    Style="{StaticResource SecondaryButton}"
                    Click="BtnLogout_Click" />
        </StackPanel>
    </Grid>
</Window>
