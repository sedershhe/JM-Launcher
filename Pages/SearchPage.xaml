<!--
    搜索页（阶段 2-C，2026-10-17 页面层 PCL2 化；2026-10-17 紧凑化）
    布局：搜索卡片（卡间距 8）→ 结果卡片 → 居中分页卡片（间距 8）；页面上下外边距 20、左右 25。
    紧凑化目标：900×550 默认窗口下结果区完整显示 2 行。做法：
      1) 关键词输入框与「搜索」主按钮同一行（按钮 120×52，输入框占满剩余宽度）；
      2) TextStatus 从搜索卡移到分页卡同一行右侧（x:Name 与绑定逻辑不变）；
      3) 只压缩卡片内边距/卡间距，封面 80×110、结果行字号、分页 35 高次按钮均保持不变。
    参数来源：docs/20261017_PCL2界面视觉规格_v1.0.md C/E 节（PageResource.xaml:9-89）。
    结果行封面 80×110 是计划书 11.6 的硬性要求（PCL2 原版是 50×50），此处以计划书为准。
    纪律：
      1) 翻页关键词由 Python 会话快照决定，本页不记忆关键词；页码由界面传；
      2) 封面只取字节，BitmapImage 在 UI 线程创建；失败显示暗红底 X；
      3) 本页用 await Search() 返回值渲染，不额外处理 search.page_loaded 事件（避免双渲染）；
      4) 所有控件 x:Name 保持不变。
-->
<UserControl x:Class="JML.Pages.SearchPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ctl="clr-namespace:JML.Controls">
    <Grid Margin="25,20,25,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 搜索卡片：输入框与 52 高主按钮同一行；状态文字已移到分页卡，见 CardPages。
             内边距由 PCL2 的 25,40,25,15 压到 25,32,25,8：标题行文字底边约 29，
             32 仍留 3px 间隙；底边 8 与卡间距 8 对齐。 -->
        <ctl:JmlCard x:Name="CardSearch" Grid.Row="0"
                     Header="搜索本子"
                     Margin="0,0,0,8"
                     Padding="25,32,25,8"
                     VerticalAlignment="Top">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBox x:Name="KeywordBox"
                         Style="{StaticResource JmlInputBox}"
                         MinHeight="32"
                         VerticalAlignment="Center"
                         ToolTip="输入关键词后按回车或点「搜索」"
                         KeyDown="KeywordBox_KeyDown" />
                <Button x:Name="BtnSearch" Grid.Column="1" Content="搜索"
                        Style="{StaticResource PrimaryButton}"
                        MinWidth="120"
                        Margin="12,0,0,0" Click="BtnSearch_Click" />
            </Grid>
        </ctl:JmlCard>

        <!-- 结果卡片：列表自带行内边距，卡片内容留 8（紧凑化前为 12） -->
        <ctl:JmlCard x:Name="CardResults" Grid.Row="1"
                     Padding="8"
                     VerticalAlignment="Stretch">
            <Grid>
                <ListBox x:Name="ResultList"
                         BorderThickness="0"
                         Background="Transparent"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         HorizontalContentAlignment="Stretch">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem" BasedOn="{StaticResource PlainListBoxItem}">
                            <Setter Property="Padding" Value="0" />
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <!-- 行间分隔：1px ColorBrushGray6；行高随 80×110 封面自适应 -->
                            <Border BorderBrush="{DynamicResource ColorBrushGray6}"
                                    BorderThickness="0,0,0,1"
                                    Padding="0,8">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <!-- 封面：占位 → 图片；失败显示暗红底 X（计划书 11.6，80×110） -->
                                    <Grid Width="80" Height="110" VerticalAlignment="Center">
                                        <Border Background="{DynamicResource ColorBrushGray7}"
                                                CornerRadius="3"
                                                Visibility="{Binding PlaceholderVisibility}">
                                            <TextBlock Text="加载中…"
                                                       FontSize="11"
                                                       Foreground="{DynamicResource ColorBrushGray3}"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center" />
                                        </Border>
                                        <Border Background="{DynamicResource ColorBrushRedBack}"
                                                CornerRadius="3"
                                                Visibility="{Binding FailureVisibility}">
                                            <TextBlock Text="X"
                                                       FontSize="36" FontWeight="Bold"
                                                       Foreground="{DynamicResource ColorBrushRedLight}"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center" />
                                        </Border>
                                        <Image Source="{Binding Cover}"
                                               Stretch="UniformToFill"
                                               Visibility="{Binding CoverVisibility}" />
                                    </Grid>

                                    <!-- 标题 14 加粗；作者 / 页数行 12 ColorBrushGray3（计划书 11.6） -->
                                    <StackPanel Grid.Column="1" Margin="12,0,12,0" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Title}"
                                                   FontWeight="Bold" FontSize="14"
                                                   TextTrimming="CharacterEllipsis"
                                                   Foreground="{DynamicResource ColorBrush1}" />
                                        <TextBlock Text="{Binding Author}"
                                                   Margin="0,4,0,0"
                                                   FontSize="12"
                                                   TextTrimming="CharacterEllipsis"
                                                   Foreground="{DynamicResource ColorBrushGray3}" />
                                        <TextBlock Text="{Binding PageInfo}"
                                                   Margin="0,2,0,0"
                                                   FontSize="12"
                                                   Foreground="{DynamicResource ColorBrushGray3}" />
                                    </StackPanel>

                                    <!-- 行内用 35 高次按钮（PCL2 25 高是纯图标按钮；这里要显示文字） -->
                                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                        <Button Content="详情"
                                                Style="{StaticResource SecondaryButton}"
                                                MinWidth="64" Click="RowDetail_Click" />
                                        <Button Content="下载"
                                                Style="{StaticResource SecondaryButton}"
                                                MinWidth="64" Margin="8,0,0,0"
                                                Click="RowDownload_Click" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <!-- 空结果：灰色文字居中（计划书 11.6） -->
                <TextBlock x:Name="TextEmpty"
                           Text="未找到相关结果"
                           Visibility="Collapsed"
                           IsHitTestVisible="False"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           FontSize="14"
                           Foreground="{DynamicResource ColorBrushGray3}" />
            </Grid>
        </ctl:JmlCard>

        <!-- 分页：居中卡片，页码 15px ColorBrush3（PageResource.xaml:78-89）。
             TextStatus 紧邻页码放在同一行右侧：正常状态（第 N 页，共 M 条结果）只占 16px 高，
             不撑高分页卡；错误文本用 12px 灰字 + MaxWidth 300 换行，仍保留完整 [error_code] 原文。 -->
        <ctl:JmlCard x:Name="CardPages" Grid.Row="2"
                     Margin="0,8,0,0"
                     Padding="10,5"
                     HorizontalAlignment="Center"
                     VerticalAlignment="Center">
            <StackPanel Orientation="Horizontal">
                <Button x:Name="BtnPrev" Content="上一页"
                        Style="{StaticResource SecondaryButton}"
                        MinWidth="84" IsEnabled="False" Click="BtnPrev_Click" />
                <TextBlock x:Name="TextPage" Text="第 1 页 / 共 1 页"
                           VerticalAlignment="Center" Margin="8,0,13,0"
                           FontSize="15"
                           Foreground="{DynamicResource ColorBrush3}" />
                <Button x:Name="BtnNext" Content="下一页"
                        Style="{StaticResource SecondaryButton}"
                        MinWidth="84" IsEnabled="False" Click="BtnNext_Click" />
                <TextBlock x:Name="TextStatus"
                           VerticalAlignment="Center" Margin="16,0,0,0"
                           MaxWidth="300"
                           TextWrapping="Wrap"
                           FontSize="12"
                           Foreground="{DynamicResource ColorBrushGray3}" />
            </StackPanel>
        </ctl:JmlCard>
    </Grid>
</UserControl>
