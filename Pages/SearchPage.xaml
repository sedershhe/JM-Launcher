<!--
    搜索页（阶段 1：仅界面框架）
    布局：上方搜索框 + 按钮；中间结果列表；下方翻页控件。
    业务逻辑在阶段 2 由 backend-agent 实现，本页不接事件。
-->
<UserControl x:Class="JML.Pages.SearchPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 上方：搜索框 -->
        <ContentControl Grid.Row="0" Style="{StaticResource PlainCard}">
            <StackPanel>
                <TextBlock Text="搜索功能（阶段 2 实现）" FontSize="15" FontWeight="SemiBold" />
                <Grid Margin="0,10,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="InputKeyword" ToolTip="输入关键词" />
                    <Button x:Name="BtnSearch" Grid.Column="1" Content="搜索" Margin="8,0,0,0" />
                </Grid>
            </StackPanel>
        </ContentControl>

        <!-- 中间：结果列表 -->
        <ContentControl Grid.Row="1" Style="{StaticResource PlainCard}" Margin="0,12,0,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <TextBlock Text="搜索结果" FontWeight="SemiBold" Margin="0,0,0,8" />
                <ListBox x:Name="ResultList" Grid.Row="1" />
            </Grid>
        </ContentControl>

        <!-- 下方：翻页 -->
        <StackPanel Grid.Row="2" Orientation="Horizontal"
                    HorizontalAlignment="Center" Margin="0,12,0,0">
            <Button x:Name="BtnPrev" Content="上一页" IsEnabled="False" />
            <TextBlock x:Name="TextPage" Text="第 1 页"
                       VerticalAlignment="Center" Margin="12,0" />
            <Button x:Name="BtnNext" Content="下一页" IsEnabled="False" />
        </StackPanel>
    </Grid>
</UserControl>
