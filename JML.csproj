<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <RootNamespace>JML</RootNamespace>
    <AssemblyName>JML</AssemblyName>

    <!-- 程序图标与文件元信息（阶段 5）：图标为 JML 自有蓝色六边形徽标（Assets\icon.ico，
         源图 Assets\JML_logo_20261018_v1.0.png）；原先沿用的 PCL2 图标已被替换 -->
    <ApplicationIcon>Assets\icon.ico</ApplicationIcon>
    <AssemblyTitle>JM Launcher</AssemblyTitle>
    <Product>JM Launcher</Product>
    <Company>JML</Company>
    <Description>JM Launcher — 禁漫下载/搜索/浏览工具</Description>
    <Version>1.0.0</Version>
    <FileVersion>1.0.0.0</FileVersion>

    <!-- 默认编译项排除临时/证据目录：按项目规则，Draw\ 与 Delete\ 专门存放临时文件与
         验收证据，而 MSBuild 的默认 glob 不看 .gitignore。子代理在 Draw\ 或 Delete\ 下留过
         临时 C# 工程时，其 obj\...AssemblyInfo.cs 会被卷进主项目，报 CS0579 特性重复。
         这里从默认项里整体剔掉这些目录，避免"临时文件污染构建"。 -->
    <DefaultItemExcludes>$(DefaultItemExcludes);Draw\**;Delete\**;_pytest_*\**;_pt_*\**;pip-*\**;pytest-cache-files-*\**</DefaultItemExcludes>
  </PropertyGroup>

  <ItemGroup>
    <!-- Python 桥接（版本由 Directory.Packages.props 集中锁定） -->
    <PackageReference Include="pythonnet" />
  </ItemGroup>

  <ItemGroup>
    <!-- PCL2 风格 UI 库（本机仓库，非 NuGet）
         实测：net10.0-windows 项目可直接引用 net8.0-windows 库，无需改动该仓库 -->
    <ProjectReference Include="..\PCLUI\PlainToolkit.UI-main\PlainToolkit.UI\PlainToolkit.UI.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- 窗口图标作为 WPF 资源嵌入程序集：MainWindow.xaml 的 Icon 指向它。 -->
    <Resource Include="Assets\icon.ico" />
  </ItemGroup>

  <ItemGroup>
    <!-- 将 Python 后端代码随输出目录分发，便于运行时定位。
         阶段 5：同时声明 CopyToPublishDirectory，保证 dotnet publish 的发布态
         不需要依赖脚本二次拷贝也能带上 Python 源码。 -->
    <None Include="Python\**\*.py"
          CopyToOutputDirectory="PreserveNewest"
          CopyToPublishDirectory="PreserveNewest" />
    <!-- 四个内置插件随构建/发布输出（排除 __pycache__ 与 .pyc：这些是运行期产物） -->
    <None Include="plugins\**\*.py"
          CopyToOutputDirectory="PreserveNewest"
          CopyToPublishDirectory="PreserveNewest" />
    <None Include="plugins\**\plugin.json"
          CopyToOutputDirectory="PreserveNewest"
          CopyToPublishDirectory="PreserveNewest" />
    <None Include="plugins\**\config.schema.json"
          CopyToOutputDirectory="PreserveNewest"
          CopyToPublishDirectory="PreserveNewest" />
    <!-- 用户安装 Python 依赖用 -->
    <None Include="requirements.txt"
          CopyToOutputDirectory="PreserveNewest"
          CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- 排除测试项目目录：否则主项目会把测试的 .cs 也编译进去，
       导致 Xunit 类型找不到、以及 AssemblyInfo 特性重复 -->
  <ItemGroup>
    <Compile Remove="JML.Tests\**" />
    <None Remove="JML.Tests\**" />
    <Page Remove="JML.Tests\**" />
    <Resource Remove="JML.Tests\**" />
    <EmbeddedResource Remove="JML.Tests\**" />
  </ItemGroup>

</Project>
