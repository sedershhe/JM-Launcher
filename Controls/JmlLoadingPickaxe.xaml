<!--
    PCL2 挥镐加载动画（2026-11-08）
    ============================================================
    几何与动效照抄 PCL2 的 Controls\MyLoading.xaml + MyLoading.xaml.vb（AniLoop）：
      · 60×47 画布；镐子 PathPickaxe（Height 35、Margin 10,6、StrokeThickness 2、
        Stretch Uniform）绕 (30,30) 旋转；左右碎屑 3×5、初始不透明度 0；
        底部 25×2 进度条。
      · 动画 1.6s 循环（本控件把 PCL2 的顺序队列压缩成一个 Storyboard）：
        0~250ms 保持 -20° → 250~600ms BackEase(EaseIn, 0.3) 转到 50°
        → 600~1500ms ElasticEase(EaseOut, Oscillations=1) 转到 25°
        → 1600ms 瞬时回到 -20° 重新开始。
      · 碎屑在 600ms 显示，650~750ms 淡出；600~780ms 位移 180ms（CubicEase/EaseOut）。
    颜色只用主题键：Foreground 默认 ColorBrush2（PCL2 主题蓝），内部 Path 绑定它。
    控件不自行设置 Visibility，由宿主决定显隐。
-->
<UserControl x:Class="JML.Controls.JmlLoadingPickaxe"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Name="Root"
             Width="60"
             Height="47"
             Focusable="False"
             Foreground="{DynamicResource ColorBrush2}">
    <UserControl.Resources>
        <!-- 总周期 1.6s，RepeatBehavior=Forever 保证循环不断。
             关键帧时间轴对应 PCL2 AniLoop 的三个 AaRotateTransform。 -->
        <Storyboard x:Key="PickaxeStoryboard"
                    Duration="0:0:1.6"
                    RepeatBehavior="Forever">
            <!-- 镐子角度：-20°（保持 250ms）→ 50°（350ms，BackEase 弱 / EaseIn）
                 → 25°（900ms，ElasticEase / EaseOut）→ 1600ms 瞬时回 -20°。 -->
            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="PickaxeRotate"
                                           Storyboard.TargetProperty="Angle">
                <DiscreteDoubleKeyFrame KeyTime="0:0:0" Value="-20" />
                <DiscreteDoubleKeyFrame KeyTime="0:0:0.25" Value="-20" />
                <EasingDoubleKeyFrame KeyTime="0:0:0.6" Value="50">
                    <EasingDoubleKeyFrame.EasingFunction>
                        <!-- PCL2：AniEaseInBack(AniEasePower.Weak)，弱回弹 -->
                        <BackEase Amplitude="0.3" EasingMode="EaseIn" />
                    </EasingDoubleKeyFrame.EasingFunction>
                </EasingDoubleKeyFrame>
                <EasingDoubleKeyFrame KeyTime="0:0:1.5" Value="25">
                    <EasingDoubleKeyFrame.EasingFunction>
                        <!-- PCL2：AniEaseOutElastic(AniEasePower.Weak)，一次回弹 -->
                        <ElasticEase Oscillations="1"
                                     Springiness="3"
                                     EasingMode="EaseOut" />
                    </EasingDoubleKeyFrame.EasingFunction>
                </EasingDoubleKeyFrame>
                <DiscreteDoubleKeyFrame KeyTime="0:0:1.6" Value="-20" />
            </DoubleAnimationUsingKeyFrames>

            <!-- 左碎屑：600ms 出现，650ms 起 100ms 淡出 → 0。 -->
            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="PathLeft"
                                           Storyboard.TargetProperty="Opacity">
                <DiscreteDoubleKeyFrame KeyTime="0:0:0" Value="0" />
                <DiscreteDoubleKeyFrame KeyTime="0:0:0.6" Value="1" />
                <DiscreteDoubleKeyFrame KeyTime="0:0:0.65" Value="1" />
                <LinearDoubleKeyFrame KeyTime="0:0:0.75" Value="0" />
                <DiscreteDoubleKeyFrame KeyTime="0:0:1.6" Value="0" />
            </DoubleAnimationUsingKeyFrames>

            <!-- 左碎屑位移：600ms 起 180ms 内 (-5,-6)，CubicEase/EaseOut 对应 AniEaseOutFluent。 -->
            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="LeftTranslate"
                                           Storyboard.TargetProperty="X">
                <DiscreteDoubleKeyFrame KeyTime="0:0:0" Value="0" />
                <DiscreteDoubleKeyFrame KeyTime="0:0:0.6" Value="0" />
                <EasingDoubleKeyFrame KeyTime="0:0:0.78" Value="-5">
                    <EasingDoubleKeyFrame.EasingFunction>
                        <CubicEase EasingMode="EaseOut" />
                    </EasingDoubleKeyFrame.EasingFunction>
                </EasingDoubleKeyFrame>
                <DiscreteDoubleKeyFrame KeyTime="0:0:1.6" Value="0" />
            </DoubleAnimationUsingKeyFrames>
            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="LeftTranslate"
                                           Storyboard.TargetProperty="Y">
                <DiscreteDoubleKeyFrame KeyTime="0:0:0" Value="0" />
                <DiscreteDoubleKeyFrame KeyTime="0:0:0.6" Value="0" />
                <EasingDoubleKeyFrame KeyTime="0:0:0.78" Value="-6">
                    <EasingDoubleKeyFrame.EasingFunction>
                        <CubicEase EasingMode="EaseOut" />
                    </EasingDoubleKeyFrame.EasingFunction>
                </EasingDoubleKeyFrame>
                <DiscreteDoubleKeyFrame KeyTime="0:0:1.6" Value="0" />
            </DoubleAnimationUsingKeyFrames>

            <!-- 右碎屑：与左侧同步淡出。 -->
            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="PathRight"
                                           Storyboard.TargetProperty="Opacity">
                <DiscreteDoubleKeyFrame KeyTime="0:0:0" Value="0" />
                <DiscreteDoubleKeyFrame KeyTime="0:0:0.6" Value="1" />
                <DiscreteDoubleKeyFrame KeyTime="0:0:0.65" Value="1" />
                <LinearDoubleKeyFrame KeyTime="0:0:0.75" Value="0" />
                <DiscreteDoubleKeyFrame KeyTime="0:0:1.6" Value="0" />
            </DoubleAnimationUsingKeyFrames>

            <!-- 右碎屑位移：(+5,-6)，与左碎屑镜像；Y 同为 -6 向上，照 PCL2 AniLoop。 -->
            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RightTranslate"
                                           Storyboard.TargetProperty="X">
                <DiscreteDoubleKeyFrame KeyTime="0:0:0" Value="0" />
                <DiscreteDoubleKeyFrame KeyTime="0:0:0.6" Value="0" />
                <EasingDoubleKeyFrame KeyTime="0:0:0.78" Value="5">
                    <EasingDoubleKeyFrame.EasingFunction>
                        <CubicEase EasingMode="EaseOut" />
                    </EasingDoubleKeyFrame.EasingFunction>
                </EasingDoubleKeyFrame>
                <DiscreteDoubleKeyFrame KeyTime="0:0:1.6" Value="0" />
            </DoubleAnimationUsingKeyFrames>
            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RightTranslate"
                                           Storyboard.TargetProperty="Y">
                <DiscreteDoubleKeyFrame KeyTime="0:0:0" Value="0" />
                <DiscreteDoubleKeyFrame KeyTime="0:0:0.6" Value="0" />
                <EasingDoubleKeyFrame KeyTime="0:0:0.78" Value="-6">
                    <EasingDoubleKeyFrame.EasingFunction>
                        <CubicEase EasingMode="EaseOut" />
                    </EasingDoubleKeyFrame.EasingFunction>
                </EasingDoubleKeyFrame>
                <DiscreteDoubleKeyFrame KeyTime="0:0:1.6" Value="0" />
            </DoubleAnimationUsingKeyFrames>
        </Storyboard>
    </UserControl.Resources>

    <Grid Width="60"
          Height="47"
          UseLayoutRounding="False"
          SnapsToDevicePixels="False">
        <!-- 镐子：Data 与 PCL2 MyLoading.xaml 完全一致；绕 (30,30) 旋转，静态初值 55°。 -->
        <Path x:Name="PathPickaxe"
              Stretch="Uniform"
              Height="35"
              Margin="10,6,0,0"
              StrokeThickness="2"
              Stroke="{Binding Foreground, ElementName=Root}"
              Fill="Transparent"
              HorizontalAlignment="Left"
              VerticalAlignment="Top"
              Data="M 963.6 858.2 410.816 305.504 C 508.116 213.304 609.204 196.8 711.104 128.6 837.11367 49.573762 879.34045 50.334062 751.5 49.5 611.3 52 471.8 96.2 353.3 182.4 309.8 155.7 252.1 161.2 214.5 198.9 176.9 236.6 171.3 294.2 198 337.7 111.8 456.3 67.6 595.8 65.1 735.9 63.315254 883.82034 65.077966 837.29308 144.2 695.488 212.4 593.588 228.888 492.4 321.088 395.2 L 873.9 948 c 0.60001 0.59999 1.6 0.6 2.2 0 l 87.5 -87.5 c 0.6 -0.7 0.6 -1.6 0 -2.3 z">
            <Path.RenderTransform>
                <RotateTransform x:Name="PickaxeRotate"
                                 Angle="55"
                                 CenterX="30"
                                 CenterY="30" />
            </Path.RenderTransform>
        </Path>

        <!-- 左碎屑：3×5，初始不透明度 0；TransformGroup 让旋转与位移可以同时动画。 -->
        <Path x:Name="PathLeft"
              Opacity="0"
              Stretch="Uniform"
              Fill="{Binding Foreground, ElementName=Root}"
              Width="3"
              Height="5"
              Data="M0,0L2,0L1,4"
              Margin="7,41,0,0"
              RenderTransformOrigin="0.5,0.5"
              HorizontalAlignment="Left"
              VerticalAlignment="Top">
            <Path.RenderTransform>
                <TransformGroup>
                    <RotateTransform Angle="-45" />
                    <TranslateTransform x:Name="LeftTranslate" />
                </TransformGroup>
            </Path.RenderTransform>
        </Path>

        <!-- 右碎屑：镜像角度 45°。 -->
        <Path x:Name="PathRight"
              Opacity="0"
              Stretch="Uniform"
              Fill="{Binding Foreground, ElementName=Root}"
              Width="3"
              Height="5"
              Data="M0,0L2,0L1,4"
              Margin="14,41,0,0"
              RenderTransformOrigin="0.5,0.5"
              HorizontalAlignment="Left"
              VerticalAlignment="Top">
            <Path.RenderTransform>
                <TransformGroup>
                    <RotateTransform Angle="45" />
                    <TranslateTransform x:Name="RightTranslate" />
                </TransformGroup>
            </Path.RenderTransform>
        </Path>

        <!-- 底部进度条：25×2（PCL2 同尺寸）。 -->
        <Rectangle Width="25"
                   Height="2"
                   Fill="{Binding Foreground, ElementName=Root}"
                   HorizontalAlignment="Left"
                   VerticalAlignment="Bottom" />
    </Grid>
</UserControl>
