<!--
    PCL2 风格折叠面板（2026-11-08，强化搜索插件阶段 3）
    ============================================================
    用途：search 模板的「高级筛选」折叠区（Pages/PluginPageHost.xaml 的
    ctl:JmlCollapse x:Name="SearchAdvanced"）。标题行整行可点，展开 / 收起时
    内容区高度做 150ms 短促缓动（不弹跳），右侧箭头同步旋转 250ms。

    视觉参数（docs/20261017_PCL2界面视觉规格_v1.0.md 与方案 §7.3）：
      外框：圆角 3、1px ColorBrushGray5、底色复用 JmlCard 的 #F5FFFFFF；
      标题行：34 高，13px ColorBrush1，左内边距 15；
      摘要：12px ColorBrushGray3，右对齐，距箭头 8；
      箭头：10×6，Data=M0,0 L5,5 L10,0（PCL2 Path 折叠箭头），
            收起 0°（v）/ 展开 180°（^）。

    为什么是 ContentControl + ResourceDictionary（与 JmlCard 相同）：
    UserControl 自带 XAML 会建立独立名称作用域，页面里写在折叠区内的
    x:Name 控件会在编译期报 MC3093。ContentControl 子类 + 隐式样式模板
    不影响页面控件的 x:Name。

    资源注册：本字典由 Pages/PluginPageHost.xaml 的 UserControl.Resources
    合并（该页是唯一使用方）；测试经同一页面创建控件，因此也能加载到样式。
    背景色引用 JmlCard.xaml 的 JmlCardBackground（JmlControls.xaml 已合并），
    保证与卡片白完全一致、不重复写 #F5FFFFFF。
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:ctl="clr-namespace:JML.Controls">

    <Style TargetType="{x:Type ctl:JmlCollapse}">
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="SnapsToDevicePixels" Value="False" />
        <Setter Property="UseLayoutRounding" Value="False" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="VerticalContentAlignment" Value="Stretch" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ctl:JmlCollapse}">
                    <Border x:Name="Root"
                            Background="{StaticResource JmlCardBackground}"
                            BorderBrush="{DynamicResource ColorBrushGray5}"
                            BorderThickness="1"
                            CornerRadius="3"
                            SnapsToDevicePixels="False">
                        <Grid>
                            <Grid.RowDefinitions>
                                <!-- 标题行 34（PCL2 折叠头高度） -->
                                <RowDefinition Height="34" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <!-- 标题行：文本 / 摘要 / 箭头 -->
                            <Grid Grid.Row="0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <TextBlock x:Name="HeaderText"
                                           Text="{TemplateBinding Header}"
                                           Margin="15,0,0,0"
                                           FontSize="13"
                                           Foreground="{DynamicResource ColorBrush1}"
                                           VerticalAlignment="Center"
                                           TextTrimming="CharacterEllipsis"
                                           IsHitTestVisible="False" />

                                <TextBlock x:Name="SummaryText"
                                           Grid.Column="1"
                                           Text="{TemplateBinding Summary}"
                                           Margin="0,0,8,0"
                                           FontSize="12"
                                           Foreground="{DynamicResource ColorBrushGray3}"
                                           VerticalAlignment="Center"
                                           TextTrimming="CharacterEllipsis"
                                           IsHitTestVisible="False" />

                                <Path x:Name="Arrow"
                                      Grid.Column="2"
                                      Width="10"
                                      Height="6"
                                      Margin="0,0,15,0"
                                      Data="M0,0 L5,5 L10,0"
                                      Stroke="{DynamicResource ColorBrushGray3}"
                                      StrokeThickness="1.5"
                                      Stretch="None"
                                      HorizontalAlignment="Right"
                                      VerticalAlignment="Center"
                                      IsHitTestVisible="False">
                                    <Path.RenderTransform>
                                        <RotateTransform x:Name="ArrowRotate"
                                                         Angle="0"
                                                         CenterX="5"
                                                         CenterY="3" />
                                    </Path.RenderTransform>
                                </Path>

                                <!-- 透明整行点击层：IsChecked 双向绑定到控件的 IsExpanded，
                                     动画由 JmlCollapse.xaml.cs 的依赖属性回调驱动。 -->
                                <ToggleButton x:Name="HeaderButton"
                                              Grid.ColumnSpan="3"
                                              Focusable="False"
                                              Background="Transparent"
                                              BorderThickness="0"
                                              HorizontalAlignment="Stretch"
                                              VerticalAlignment="Stretch"
                                              IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}">
                                    <ToggleButton.Template>
                                        <ControlTemplate TargetType="ToggleButton">
                                            <Border Background="Transparent" />
                                        </ControlTemplate>
                                    </ToggleButton.Template>
                                </ToggleButton>
                            </Grid>

                            <!-- 内容区：高度由控件代码补间；ClipToBounds 保证收起过程中
                                 内容被裁切而不是溢出（收起完成后 Visibility=Collapsed）。 -->
                            <Border x:Name="ContentHost"
                                    Grid.Row="1"
                                    Height="0"
                                    Visibility="Collapsed"
                                    ClipToBounds="True">
                                <ContentPresenter Margin="15,0,15,12"
                                                  Content="{TemplateBinding Content}"
                                                  ContentTemplate="{TemplateBinding ContentTemplate}"
                                                  ContentStringFormat="{TemplateBinding ContentStringFormat}"
                                                  HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                  VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                            </Border>
                        </Grid>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
