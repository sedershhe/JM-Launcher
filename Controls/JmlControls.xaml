<!--
    JML 自定义控件样式资源字典（外壳重构，2026-10-17）
    参数来源：docs/20261017_PCL2界面视觉规格_v1.0.md
      A2 自定义标题栏：高 48、纯蓝 ColorObject4、文字 logo、28×28 图标按钮
      A4 顶部一级导航：27 高、圆角 13.5、白胶囊选中、白字/蓝字
      B  左侧二级目录：行高 36、5×（行高−12）选中条、#BEE0EAFD 悬停、12px 分组标题
    配色一律引用 PlainToolkit.UI 的 DynamicResource 画刷，不自行硬编码主题色。
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ResourceDictionary.MergedDictionaries>
        <!-- PCL2 风格卡片：隐式样式 TargetType=JML.Controls.JmlCard（Controls\JmlCard.xaml） -->
        <ResourceDictionary Source="pack://application:,,,/JML;component/Controls/JmlCard.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <!-- ========== 窗体内容底色 ==========
         PCL2 默认 UiBackgroundColorful=True，运行时用 HSL(hue±15, sat×0.8, 91) 三停靠斜向渐变
         （ModSecret.vb:122-130）。其 HSL 是带按色相亮度校正的自研实现，无法用静态色值精确复算；
         这里用主题里现成的极淡蓝（ColorBrush8 → ColorBrush7 → ColorBrush8）做同观感近似。 -->
    <LinearGradientBrush x:Key="JmlPageBackground" StartPoint="0.9,0" EndPoint="0.1,1">
        <GradientStop Offset="0" Color="{DynamicResource ColorObject8}" />
        <GradientStop Offset="0.45" Color="{DynamicResource ColorObject7}" />
        <GradientStop Offset="1" Color="{DynamicResource ColorObject8}" />
    </LinearGradientBrush>

    <!-- ========== 插件页左栏（PCL2 FormMain.xaml:144-152 / Application.xaml:66） ==========
         左栏底色 #F1FFFFFF（alpha 241 白）；左右分界不用 1px 边框，而是左栏右侧 4 宽的
         横向渐变阴影（黑 4% → 透明）。#F1FFFFFF 是 PCL2 原值，按任务约定只写这里一次并注释来源。 -->
    <SolidColorBrush x:Key="JmlSidebarBackground" Color="#F1FFFFFF" />
    <LinearGradientBrush x:Key="JmlSidebarShadow" StartPoint="0,0" EndPoint="1,0" Opacity="0.04">
        <GradientStop Color="#000000" Offset="0" />
        <GradientStop Color="#00000000" Offset="1" />
    </LinearGradientBrush>

    <!-- ========== 可输入文本框（基线主题的 PlainTextBox 空态几乎不可见） ==========
         基线 PlainTextBox 的 Background=ColorBrushTransparent、BorderBrush=ColorBrushBg0
         （≈卡片底色），未悬停/未聚焦时空输入框看不出边界。
         这里只把 Background 换成模板里悬停态已经在用的淡色，模板本身与外部 UI 库都不动；
         悬停/聚焦时模板的 HoverOverlay / FocusOverlay 仍按原逻辑覆盖。 -->
    <Style x:Key="JmlInputBox" TargetType="TextBox" BasedOn="{StaticResource PlainTextBox}">
        <Setter Property="Background" Value="{DynamicResource ColorBrushInputHoverBg}" />
    </Style>

    <!-- ========== 顶部一级导航胶囊（PCL2 MyRadioButton） ==========
         MyRadioButton.xaml:4  MinHeight/MaxHeight=27、CornerRadius=13.5、背景 #01EAF2FE
         MyRadioButton.xaml:6  图标 Path Margin=12,0,0,0、MaxHeight/MaxWidth=16、Stretch=Uniform、Fill=White
         MyRadioButton.xaml:7  文字 Margin=8,0,12,0、前景 White、字号继承 13
         FormMain.xaml:121-130 每项 Margin=5,0、Padding=2,0
         MyRadioButton.xaml.vb:166/167/168/184 悬停 90ms、移出 150ms、勾选 120ms、按下 60ms
         MyRadioButton.xaml.vb:191 悬停底 MyColor(50, Color8) = #32EAF2FE（JML 旧值 #32FFFFFF 已按 PCL2 改正）
         MyRadioButton.xaml.vb:184 按下底 MyColor(120, Color8) = #78EAF2FE
         MyRadioButton.xaml.vb:181 选中底纯白 + 字色 ColorBrush3
         动效落点：悬停/按下各一层自绘底色，由 MainWindow.xaml.cs 的 NavMotion 按状态机
         淡入淡出；模板只保留 IsChecked 的静态白色，保证回归测试与无动画路径可用。 -->
    <Style x:Key="NavRadioButton" TargetType="RadioButton">
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="SnapsToDevicePixels" Value="False" />
        <Setter Property="UseLayoutRounding" Value="False" />
        <Setter Property="Height" Value="27" />
        <Setter Property="Margin" Value="5,0" />
        <Setter Property="Padding" Value="2,0" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Foreground" Value="White" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Border x:Name="Root"
                            Background="{DynamicResource ColorBrushSemiTransparent}"
                            CornerRadius="13.5"
                            Padding="{TemplateBinding Padding}"
                            SnapsToDevicePixels="False"
                            UseLayoutRounding="False">
                        <Grid>
                            <!-- 悬停底 #32EAF2FE / 按下底 #78EAF2FE：元素 Opacity 由 NavMotion 驱动。 -->
                            <Border x:Name="HoverLayer"
                                    Background="#32EAF2FE"
                                    CornerRadius="13.5"
                                    Opacity="0"
                                    IsHitTestVisible="False" />
                            <Border x:Name="PressLayer"
                                    Background="#78EAF2FE"
                                    CornerRadius="13.5"
                                    Opacity="0"
                                    IsHitTestVisible="False" />
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              Margin="12,0,12,0" />
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Root" Property="Background"
                                    Value="{DynamicResource ColorBrushWhite}" />
                            <Setter Property="Foreground" Value="{DynamicResource ColorBrush3}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ========== 标题栏圆形图标按钮（PCL2 MyIconButton Theme=White） ==========
         MyIconButton.xaml:4-6  CornerRadius=1000、Path Margin=5、Stretch=Uniform
         MyIconButton.xaml.vb:117 悬停底色白 20%（MyColor(50,255,255,255)=#32FFFFFF），时长 120ms（:160）
         MyIconButton.xaml.vb:130-131 Theme=White → Path.Fill=ColorBrush8 #EAF2FE
         MyIconButton.xaml.vb:70 按下内容缩放 1→0.8/400ms；:77-78 抬起 0.8→1.0（250ms，复合）
         动效落点：底色用 HoverLayer/PressLayer 的元素 Opacity，缩放由 IconButtonMotion
         （MainWindow.xaml.cs）在按钮 RenderTransform 上做，模板不参与缩放。
         28×28 与右边距 12/44 由使用方（MainWindow）设置。 -->
    <Style x:Key="TitleIconButton" TargetType="Button">
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Width" Value="28" />
        <Setter Property="Height" Value="28" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Root"
                            Background="{TemplateBinding Background}"
                            CornerRadius="1000"
                            SnapsToDevicePixels="False"
                            UseLayoutRounding="False">
                        <Grid>
                            <Border x:Name="HoverLayer"
                                    Background="#32FFFFFF"
                                    CornerRadius="1000"
                                    Opacity="0"
                                    IsHitTestVisible="False" />
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Grid>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ========== 左侧栏列表项（PCL2 MyListItem） ==========
         MyListItem.xaml:5 Height=42，页面覆盖为 36（PageDownloadLeft.xaml:8）
         MyListItem.xaml.vb:191 FontSize=14
         MyListItem.xaml.vb:303 勾选列宽 6 → 文字列左边距 4（:339），合计 10
         MyListItem.xaml.vb:316-320 选中条宽 5、CornerRadius=2、Margin=-1,6,0,6（高度=行高−12）、色 ColorBrush3
         MyListItem.xaml.vb:470 行高 <40 时选中文字色 ColorBrush3
         MyListItem.xaml.vb:580/597 悬停底 ColorBrushBg1 #BEE0EAFD、按下底 ColorBrush6
         MyListItem.xaml.vb:575-600 悬停进 120ms（背景/底色）、移出 180ms；按下同 120ms
         PageDownloadLeft.xaml:8 IsScaleAnimationEnabled=False → 不做 0.98 缩放
         动效落点：悬停/按下各一层底色做 Opacity 淡入淡出（不触发布局）；选中条
         Visibility 保持原触发器（回归测试依赖），另用 200ms 的 Opacity/ScaleY + 一层
         ColorBrush2 淡出的 Tint 做“颜色过渡”，不直接动画共享主题画刷。 -->
    <Style x:Key="SideListItem" TargetType="RadioButton">
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="SnapsToDevicePixels" Value="False" />
        <Setter Property="UseLayoutRounding" Value="False" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Height" Value="36" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Foreground" Value="{DynamicResource ColorBrush1}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Grid>
                        <Border x:Name="Root"
                                Background="Transparent"
                                SnapsToDevicePixels="False" />
                        <Border x:Name="HoverLayer"
                                Background="{DynamicResource ColorBrushBg1}"
                                Opacity="0"
                                IsHitTestVisible="False" />
                        <Border x:Name="PressLayer"
                                Background="{DynamicResource ColorBrush6}"
                                Opacity="0"
                                IsHitTestVisible="False" />
                        <Rectangle x:Name="SelectionBar"
                                   Width="5"
                                   HorizontalAlignment="Left"
                                   VerticalAlignment="Stretch"
                                   Margin="-1,6,0,6"
                                   RadiusX="2" RadiusY="2"
                                   Opacity="0"
                                   RenderTransformOrigin="0.5,0.5"
                                   Fill="{DynamicResource ColorBrush3}"
                                   Visibility="Collapsed">
                            <Rectangle.RenderTransform>
                                <ScaleTransform ScaleX="1" ScaleY="0.7" />
                            </Rectangle.RenderTransform>
                        </Rectangle>
                        <!-- 选中瞬间的浅色底：从 ColorBrush2 淡出，露出下面的 ColorBrush3，
                             形成“选中条颜色过渡”（不直接动画共享主题画刷）。 -->
                        <Rectangle x:Name="SelectionBarTint"
                                   Width="5"
                                   HorizontalAlignment="Left"
                                   VerticalAlignment="Stretch"
                                   Margin="-1,6,0,6"
                                   RadiusX="2" RadiusY="2"
                                   Opacity="1"
                                   Fill="{DynamicResource ColorBrush2}"
                                   IsHitTestVisible="False"
                                   Visibility="Collapsed" />
                        <ContentPresenter HorizontalAlignment="Left"
                                          VerticalAlignment="Center"
                                          Margin="10,0,8,0" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="HoverLayer"
                                                         Storyboard.TargetProperty="Opacity"
                                                         To="1" Duration="0:0:0.120" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="HoverLayer"
                                                         Storyboard.TargetProperty="Opacity"
                                                         To="0" Duration="0:0:0.180" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="PressLayer"
                                                         Storyboard.TargetProperty="Opacity"
                                                         To="1" Duration="0:0:0.120" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="PressLayer"
                                                         Storyboard.TargetProperty="Opacity"
                                                         To="0" Duration="0:0:0.180" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="SelectionBar" Property="Visibility" Value="Visible" />
                            <Setter TargetName="SelectionBarTint" Property="Visibility" Value="Visible" />
                            <Setter Property="Foreground" Value="{DynamicResource ColorBrush3}" />
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <!-- 选中条本体：200ms 淡入 + 300ms 纵向落位（RenderTransform，不触发布局） -->
                                        <DoubleAnimation Storyboard.TargetName="SelectionBar"
                                                         Storyboard.TargetProperty="Opacity"
                                                         To="1" Duration="0:0:0.200" />
                                        <DoubleAnimation Storyboard.TargetName="SelectionBar"
                                                         Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                                         To="1" Duration="0:0:0.300" />
                                        <!-- 浅色 Tint 200ms 淡出 → 颜色从 ColorBrush2 过渡到 ColorBrush3 -->
                                        <DoubleAnimation Storyboard.TargetName="SelectionBarTint"
                                                         Storyboard.TargetProperty="Opacity"
                                                         To="0" Duration="0:0:0.200" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="SelectionBar"
                                                         Storyboard.TargetProperty="Opacity"
                                                         To="0" Duration="0:0:0.120" />
                                        <DoubleAnimation Storyboard.TargetName="SelectionBar"
                                                         Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                                         To="0.7" Duration="0:0:0.120" />
                                        <DoubleAnimation Storyboard.TargetName="SelectionBarTint"
                                                         Storyboard.TargetProperty="Opacity"
                                                         To="1" Duration="0:0:0.120" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ========== 左栏分组标题（PageDownloadLeft.xaml:16） ==========
         FontSize=12、Opacity=0.6、Margin=13,20,5,4、前景继承 ColorBrush1 -->
    <Style x:Key="SideGroupTitle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Opacity" Value="0.6" />
        <Setter Property="Margin" Value="13,20,5,4" />
        <Setter Property="Foreground" Value="{DynamicResource ColorBrush1}" />
    </Style>

    <!-- ========== 主行动按钮（PCL2 MyExtraTextButton 52 高胶囊） ==========
         MyExtraTextButton.xaml:7        Height=52、Margin=20（由使用方设置）
         MyExtraTextButton.xaml:12-22    CornerRadius=ActualHeight×0.4（52×0.4=20.8）、
                                         底 ColorBrush3、字 ColorBrush8 16px、
                                         DropShadowEffect ShadowDepth=0 BlurRadius=10 Opacity=0.2
         MyExtraTextButton.xaml.vb:140/143 悬停底 ColorBrush4（120ms）、常态回 ColorBrush3（150ms）
         MyExtraTextButton.xaml.vb:150-154 禁用 ColorBrushGray4
         动效落点：悬停用一层 ColorBrush4 覆盖层做 120ms Opacity 淡入、150ms 淡出；
         不动画 DropShadowEffect（规格 13.2-2 / 13.3 补充）。按下缩放本轮未做（任务只要求悬停颜色）。
         使用：下载页「开始下载」、搜索页「搜索」、详情窗「下载本子」。 -->
    <Style x:Key="PrimaryButton" TargetType="Button">
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="SnapsToDevicePixels" Value="False" />
        <Setter Property="UseLayoutRounding" Value="False" />
        <Setter Property="Height" Value="52" />
        <Setter Property="MinWidth" Value="140" />
        <Setter Property="Padding" Value="20,0" />
        <Setter Property="FontSize" Value="16" />
        <Setter Property="Foreground" Value="{DynamicResource ColorBrush8}" />
        <Setter Property="Background" Value="{DynamicResource ColorBrush3}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Root"
                            Background="{TemplateBinding Background}"
                            CornerRadius="20.8"
                            SnapsToDevicePixels="False"
                            UseLayoutRounding="False">
                        <Border.Effect>
                            <!-- PCL2 MyExtraTextButton.xaml:20-22 只设 ShadowDepth/BlurRadius/Opacity，
                                 颜色取 DropShadowEffect 默认黑。 -->
                            <DropShadowEffect ShadowDepth="0"
                                              BlurRadius="10"
                                              Opacity="0.2" />
                        </Border.Effect>
                        <Grid>
                            <!-- 悬停底色 ColorBrush4：120ms 淡入 / 150ms 淡出（不触发布局） -->
                            <Border x:Name="HoverLayer"
                                    Background="{DynamicResource ColorBrush4}"
                                    CornerRadius="20.8"
                                    Opacity="0"
                                    IsHitTestVisible="False" />
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}" />
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="HoverLayer"
                                                         Storyboard.TargetProperty="Opacity"
                                                         To="1" Duration="0:0:0.120" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="HoverLayer"
                                                         Storyboard.TargetProperty="Opacity"
                                                         To="0" Duration="0:0:0.150" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Root" Property="Background"
                                    Value="{DynamicResource ColorBrushGray4}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ========== 次按钮（PCL2 MyButton，35 高描边） ==========
         MyButton.xaml:6  CornerRadius=3、BorderThickness=1、BorderBrush=ColorBrush1
         MyButton.xaml:3  Background=ColorBrushHalfWhite #55FFFFFF
         MyButton.xaml:10 文字 13px，颜色跟随边框（模板里 Binding BorderBrush）
         MyButton.xaml.vb:160-170 禁用 = 边框 Gray4 + 底 Gray6
         悬停底 ColorBrush7 由基线 PlainButton 模板的 HoverBg 提供（ColorBrushButtonHoverBg=ColorBrush7）。
         使用：浏览…、取消、上一页/下一页、插件页操作按钮、搜索行内「详情」「下载」。 -->
    <Style x:Key="SecondaryButton" TargetType="Button" BasedOn="{StaticResource PlainButton}">
        <Setter Property="Height" Value="35" />
        <Setter Property="MinWidth" Value="76" />
        <Setter Property="Padding" Value="14,0" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Background" Value="{DynamicResource ColorBrushHalfWhite}" />
        <Setter Property="BorderBrush" Value="{DynamicResource ColorBrush1}" />
    </Style>

    <!-- ========== 插件页 DataGrid（PCL2 观感：无粗边框、36 行高、浅色表头） ==========
         PCL2 没有 DataGrid；行高取左栏列表项 36（PageDownloadLeft.xaml:8），
         表头沿用基线 PlainDataGridColumnHeader（12px SemiBold、ColorBrush8 底），
         只把 DataGrid 的 1px 边框去掉、底色改透明、行高与表头高度显式化。 -->
    <Style x:Key="JmlDataGrid" TargetType="DataGrid" BasedOn="{StaticResource PlainDataGrid}">
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="RowHeight" Value="36" />
        <Setter Property="ColumnHeaderHeight" Value="34" />
        <Setter Property="GridLinesVisibility" Value="Horizontal" />
        <Setter Property="HorizontalGridLinesBrush" Value="{DynamicResource ColorBrushGray7}" />
        <Setter Property="AlternatingRowBackground" Value="Transparent" />
        <Setter Property="SelectionMode" Value="Single" />
        <Setter Property="HeadersVisibility" Value="Column" />
        <Setter Property="CanUserResizeRows" Value="False" />
    </Style>

</ResourceDictionary>
