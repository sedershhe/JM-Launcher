<!--
    JML 自定义控件样式资源字典（阶段 1）
    用途：顶部一级导航 RadioButton（NavRadioButton）、左侧栏列表项（SideListItem）、
          可输入文本框（JmlInputBox）。
    配色一律引用 PlainToolkit.UI 的 DynamicResource 画刷，不自行硬编码颜色。
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ========== 可输入文本框（基线主题的 PlainTextBox 空态几乎不可见） ==========
         基线 PlainTextBox 的 Background=ColorBrushTransparent、BorderBrush=ColorBrushBg0
         （≈卡片底色），未悬停/未聚焦时空输入框看不出边界。
         这里只把 Background 换成模板里悬停态已经在用的淡色，模板本身与外部 UI 库都不动；
         悬停/聚焦时模板的 HoverOverlay / FocusOverlay 仍按原逻辑覆盖。 -->
    <Style x:Key="JmlInputBox" TargetType="TextBox" BasedOn="{StaticResource PlainTextBox}">
        <Setter Property="Background" Value="{DynamicResource ColorBrushInputHoverBg}" />
    </Style>

    <!-- ========== 顶部一级导航按钮（PCL2 风格：选中高亮、悬停变色） ========== -->
    <Style x:Key="NavRadioButton" TargetType="RadioButton">
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="SnapsToDevicePixels" Value="False" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Foreground" Value="{DynamicResource ColorBrush1}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Border x:Name="Root"
                            Background="Transparent"
                            CornerRadius="4"
                            Padding="12,0"
                            Margin="2,6">
                        <ContentPresenter HorizontalAlignment="Center"
                                          VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Root" Property="Background"
                                    Value="{DynamicResource ColorBrush8}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Root" Property="Background"
                                    Value="{DynamicResource ColorBrush7}" />
                            <Setter Property="Foreground"
                                    Value="{DynamicResource ColorBrush2}" />
                            <Setter Property="FontWeight" Value="SemiBold" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ========== 左侧栏列表项（PCL2 风格：高 36、选中左侧蓝色指示条） ========== -->
    <Style x:Key="SideListItem" TargetType="RadioButton">
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="SnapsToDevicePixels" Value="False" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Height" Value="36" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Foreground" Value="{DynamicResource ColorBrush1}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Grid>
                        <Border x:Name="Root"
                                Background="Transparent"
                                CornerRadius="3"
                                Padding="14,0" />
                        <Rectangle x:Name="SelectionBar"
                                   Width="3" Height="16"
                                   HorizontalAlignment="Left"
                                   VerticalAlignment="Center"
                                   RadiusX="1.5" RadiusY="1.5"
                                   Fill="{DynamicResource ColorBrush2}"
                                   Visibility="Collapsed" />
                        <ContentPresenter HorizontalAlignment="Left"
                                          VerticalAlignment="Center"
                                          Margin="14,0,8,0" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Root" Property="Background"
                                    Value="{DynamicResource ColorBrush8}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Root" Property="Background"
                                    Value="{DynamicResource ColorBrush7}" />
                            <Setter TargetName="SelectionBar" Property="Visibility"
                                    Value="Visible" />
                            <Setter Property="Foreground"
                                    Value="{DynamicResource ColorBrush2}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
